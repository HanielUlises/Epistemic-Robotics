; Biblioteca de tipos de acción: robot-lib
; Caso de estudio: Multi-Robot Box Task

(define (action-type-library robot-lib)

  (:requirements :partial-observability :events-conditions)

  ; Tipo private: solo el actor observa (Fully), los demás son ajenos (Oblivious)
  (:action-type private
    :events              (?e ?nil)
    :observability-types (Fully Oblivious)
    :relations  (Fully     (:forall (?e - event) (?e ?e))
                 Oblivious (:forall (?e - event) (?e ?nil)) )
    :designated (?e)
    :conditions (?e   (:non-trivial-postconditions)
                 ?nil (:trivial-event) )
  )

  ; Tipo basic: todos los agentes observan el mismo evento (anuncio público)
  (:action-type basic
    :events              (?e)
    :observability-types (Fully)
    :relations  (Fully (:forall (?e - event) (?e ?e)))
    :designated (?e)
  )

)
