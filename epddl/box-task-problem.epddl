; Problema EPDDL: box-task-1
; Estado inicial: la caja está en A, r1 está en A, r1 ya observó la caja
; Meta: holding(r2) ∧ B_r1(holding(r2))

(define (problem box-task-1)

  (:domain box-task)

  (:requirements
    :finitary-S5-theories :modal-goals :negative-preconditions
  )

  (:agents r1 r2)

  (:init
    (:and
      (boxAt-A)
      (at-A r1)
      (at-A r2)
      (seen r1)
      (not (holding r1))
      (not (holding r2))
      ([C. All] (and
        (or (boxAt-A) (boxAt-B))
        (not (and (boxAt-A) (boxAt-B)))
        (at-A r1)
        (at-A r2) ))
      ([C. All] (<Kw. r1> (boxAt-A)))
      ([C. All] (<Kw. r2> (boxAt-A)))
    )
  )

  (:goal
    (and
      (holding r2)          ; hecho físico
      ([r1] (holding r2))   ; creencia de r1
    )
  )

)
