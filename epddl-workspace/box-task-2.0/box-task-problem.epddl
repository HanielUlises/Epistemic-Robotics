; Problema EPDDL: box-task-1
; Estado inicial: la caja está en A, r1 está en A (lo sabe todo el mundo),
;                 r2 puede estar en A o en B (incertidumbre sobre su posición)
; Meta: holding(r2) ∧ B_r1(holding(r2))

(define (problem box-task-1)

  (:domain box-task)

  (:requirements
    :finitary-S5-theories :modal-goals :negative-preconditions
  )

  (:agents r1 r2)

  (:init
    (:and
      ; Hechos físicos ciertos
      (boxAt-A)
      (at-A r1)
      (seen r1)
      (not (holding r1))
      (not (holding r2))

      ; La caja está exactamente en uno de los dos cuartos (siempre)
      ([C. All] (and
        (or (boxAt-A) (boxAt-B))
        (not (and (boxAt-A) (boxAt-B)))
      ))

      ; r1 siempre está en A (todo el mundo lo sabe)
      ([C. All] (at-A r1))

      ; r2 puede estar en A o en B — incertidumbre epistémica
      ; (no hay [C.All](at-A r2) ni [C.All](at-B r2))

      ; r1 sabe dónde está la caja
      ([C. All] (<Kw. r1> (boxAt-A)))
    )
  )

  (:goal
    (and
      (holding r2)          ; hecho físico
      ([r1] (holding r2))   ; creencia de r1
    )
  )

)
