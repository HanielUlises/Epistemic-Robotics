      ([C. All] (not (called r8 r7)))
      ([C. All] (not (by r8 r8)))
      ([C. All] (not (called r8 r8)))
      ;; who knows of the task
      ([C. All] ([Kw. r1] (task)))
      ([C. All] (<Kw. r2> (task)))
      ([C. All] (<Kw. r3> (task)))
      ([C. All] (<Kw. r5> (task)))
      ([C. All] (<Kw. r4> (task)))
      ([C. All] (<Kw. r6> (task)))
      ([C. All] (<Kw. r7> (task)))
      ([C. All] (<Kw. r8> (task)))
      ;; who may be busy, and that each knows whether it is
      ([C. All] (not (busy r1)))
      ([C. All] ([Kw. r2] (busy r2)))
      ([C. All] ([Kw. r3] (busy r3)))
      ([C. All] ([Kw. r5] (busy r5)))
      ([C. All] ([Kw. r4] (busy r4)))
      ([C. All] ([Kw. r6] (busy r6)))
      ([C. All] ([Kw. r7] (busy r7)))
      ([C. All] ([Kw. r8] (busy r8)))
      ([C. All] (not (and (busy r2) (busy r3) (busy r5))))
      ([C. All] (not (and (busy r2) (busy r3) (busy r4))))
      ([C. All] (not (and (busy r2) (busy r3) (busy r6))))
      ([C. All] (not (and (busy r2) (busy r3) (busy r7))))
      ([C. All] (not (and (busy r2) (busy r3) (busy r8))))
      ([C. All] (not (and (busy r2) (busy r5) (busy r4))))
