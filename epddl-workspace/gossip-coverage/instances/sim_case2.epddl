(define (problem sim_case2)

  ;; Written by tools/gossip/epddl.py. r1 has found a task that needs 3 of 8 robots; r1 know of it; r2, r3, r5, r4, r6, r7, r8 may be busy, at most 2.

  (:domain gossip-coverage)

  (:requirements
    :facts :equality :list-comprehensions :finitary-S5-theories :modal-goals
    :knowing-whether :multi-pointed-models :negative-preconditions
  )

  (:agents r1 r2 r3 r5 r4 r6 r7 r8)

  (:facts-init
    (need3)
    (near r1 r2) (near r1 r3) (near r1 r5) (near r2 r1) (near r2 r4) (near r2 r5) (near r3 r1) (near r3 r5) (near r3 r6) (near r4 r2) (near r4 r5) (near r4 r7) (near r5 r1) (near r5 r2) (near r5 r3) (near r5 r4) (near r5 r6) (near r5 r7) (near r5 r8) (near r6 r3) (near r6 r5) (near r6 r8) (near r7 r4) (near r7 r5) (near r7 r8) (near r8 r5) (near r8 r6) (near r8 r7)
  )

