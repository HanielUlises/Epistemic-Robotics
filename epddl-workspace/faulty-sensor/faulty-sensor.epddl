;; A FAULTY SENSOR IN THE FLEET: an error belongs to a sensor. Written by
;; tools/model.py in faulty_sensor_demo; do not edit by hand.
;;
;; A hospital floor at night. Four fire doors, A to D from west to east, close
;; four passages through a band of linen rooms between the hall and the corridor.
;; On his round the night porter shut two of them. A scout reads a door from its
;; passage's mouth, more than five metres off, or from the mark before it. A
;; short-sighted laser gets no return from a leaf that far away, and reads every
;; door open from a mouth; at the mark every laser reads right. A bed-mover
;; cannot turn round in a passage, and drives in only when it is sure enough
;; that the door is open.
;;
;; Every world carries its Spohn rank as a grade atom (rank0 .. rank5). Belief
;; is a formula over knowledge and the grades: a reading removes worlds, and the
;; least grade among those left says what is believed, and how firmly.
;;
;; Here a world is the porter's round and the set of short-sighted scouts, and
;; its rank the sum of their grades. A scout that has read one door shut is
;; known sound, and what it reads open is then known open.

(define (domain faulty-sensor)

  (:requirements
    :equality :partial-observability :ontic-actions :negative-preconditions
    :modal-preconditions :conditional-effects :universal-preconditions :disjunctive-preconditions
  )

  (:action-type-libraries intermediate)

  (:predicates
    (open-a)
    (open-b)
    (open-c)
    (open-d)
    (short ?r - agent)
    (rank0)
    (rank1)
    (rank2)
    (rank3)
    (rank4)
    (rank5)
    (at-hd ?r - agent)
    (at-ld ?r - agent)
    (at-ht ?r - agent)
    (at-hp ?r - agent)
    (at-va ?r - agent)
    (at-vb ?r - agent)
    (at-sl ?r - agent)
    (at-st ?r - agent)
    (at-vc ?r - agent)
    (at-vd ?r - agent)
    (at-sp ?r - agent)
    (at-ma ?r - agent)
    (at-mb ?r - agent)
    (at-mc ?r - agent)
    (at-md ?r - agent)
    (at-na ?r - agent)
    (at-nb ?r - agent)
    (at-nc ?r - agent)
    (at-nd ?r - agent)
    (scout ?r - agent)
    (mover ?r - agent)
    (delivered ?r - agent)
  )

  (:event nil)

  ;;--------------------THE HALL------------------
  ;;
  ;; Out of a room to the hall, and a hop along it. Every robot sees every drive.

  (:event e-set-out
    :parameters (?r - agent)
    :precondition (or (at-hd ?r) (at-ld ?r) (at-ht ?r) (at-hp ?r))
    :effects (:and (when (at-hd ?r) (:and (at-va ?r) (not (at-hd ?r)))) (when (at-ld ?r) (:and (at-sl ?r) (not (at-ld ?r)))) (when (at-ht ?r) (:and (at-st ?r) (not (at-ht ?r)))) (when (at-hp ?r) (:and (at-sp ?r) (not (at-hp ?r)))))
  )

  (:action set-out
    :parameters (?r - agent)
    :action-type (public-ontic (e-set-out ?r))
    :observability-conditions (default Fully)
  )

  (:event e-hop-va-vb
    :parameters (?r - agent)
    :precondition (at-va ?r)
    :effects (:and (at-vb ?r) (not (at-va ?r)))
  )

  (:action hop-va-vb
    :parameters (?r - agent)
    :action-type (public-ontic (e-hop-va-vb ?r))
    :observability-conditions (default Fully)
  )

  (:event e-hop-vb-va
    :parameters (?r - agent)
    :precondition (at-vb ?r)
    :effects (:and (at-va ?r) (not (at-vb ?r)))
  )

  (:action hop-vb-va
    :parameters (?r - agent)
    :action-type (public-ontic (e-hop-vb-va ?r))
    :observability-conditions (default Fully)
  )

  (:event e-hop-vb-sl
    :parameters (?r - agent)
    :precondition (at-vb ?r)
    :effects (:and (at-sl ?r) (not (at-vb ?r)))
  )

  (:action hop-vb-sl
    :parameters (?r - agent)
    :action-type (public-ontic (e-hop-vb-sl ?r))
    :observability-conditions (default Fully)
  )

  (:event e-hop-sl-vb
    :parameters (?r - agent)
    :precondition (at-sl ?r)
    :effects (:and (at-vb ?r) (not (at-sl ?r)))
  )

  (:action hop-sl-vb
    :parameters (?r - agent)
    :action-type (public-ontic (e-hop-sl-vb ?r))
    :observability-conditions (default Fully)
  )

  (:event e-hop-sl-st
    :parameters (?r - agent)
    :precondition (at-sl ?r)
    :effects (:and (at-st ?r) (not (at-sl ?r)))
  )

  (:action hop-sl-st
    :parameters (?r - agent)
    :action-type (public-ontic (e-hop-sl-st ?r))
    :observability-conditions (default Fully)
  )

  (:event e-hop-st-sl
    :parameters (?r - agent)
    :precondition (at-st ?r)
    :effects (:and (at-sl ?r) (not (at-st ?r)))
  )

  (:action hop-st-sl
    :parameters (?r - agent)
    :action-type (public-ontic (e-hop-st-sl ?r))
    :observability-conditions (default Fully)
  )

  (:event e-hop-st-vc
    :parameters (?r - agent)
    :precondition (at-st ?r)
    :effects (:and (at-vc ?r) (not (at-st ?r)))
  )

  (:action hop-st-vc
    :parameters (?r - agent)
    :action-type (public-ontic (e-hop-st-vc ?r))
    :observability-conditions (default Fully)
  )

  (:event e-hop-vc-st
    :parameters (?r - agent)
    :precondition (at-vc ?r)
    :effects (:and (at-st ?r) (not (at-vc ?r)))
  )

  (:action hop-vc-st
    :parameters (?r - agent)
    :action-type (public-ontic (e-hop-vc-st ?r))
    :observability-conditions (default Fully)
  )

  (:event e-hop-vc-vd
    :parameters (?r - agent)
    :precondition (at-vc ?r)
    :effects (:and (at-vd ?r) (not (at-vc ?r)))
  )

  (:action hop-vc-vd
    :parameters (?r - agent)
    :action-type (public-ontic (e-hop-vc-vd ?r))
    :observability-conditions (default Fully)
  )

  (:event e-hop-vd-vc
    :parameters (?r - agent)
    :precondition (at-vd ?r)
    :effects (:and (at-vc ?r) (not (at-vd ?r)))
  )

  (:action hop-vd-vc
    :parameters (?r - agent)
    :action-type (public-ontic (e-hop-vd-vc ?r))
    :observability-conditions (default Fully)
  )

  (:event e-hop-vd-sp
    :parameters (?r - agent)
    :precondition (at-vd ?r)
    :effects (:and (at-sp ?r) (not (at-vd ?r)))
  )

  (:action hop-vd-sp
    :parameters (?r - agent)
    :action-type (public-ontic (e-hop-vd-sp ?r))
    :observability-conditions (default Fully)
  )

  (:event e-hop-sp-vd
    :parameters (?r - agent)
    :precondition (at-sp ?r)
    :effects (:and (at-vd ?r) (not (at-sp ?r)))
  )

  (:action hop-sp-vd
    :parameters (?r - agent)
    :action-type (public-ontic (e-hop-sp-vd ?r))
    :observability-conditions (default Fully)
  )

  ;;--------------------READINGS FROM A MOUTH------------------
  ;;
  ;; A scout looks down a passage from its mouth. It reads the door shut only where
  ;; the door is shut and the reading does not err. The scout sees what it read; the
  ;; others see that it looked.

  (:event e-look-a-open
    :parameters (?r - agent)
    :precondition (and (scout ?r) (at-va ?r) (or (open-a) (short ?r)))
  )

  (:event e-look-a-shut
    :parameters (?r - agent)
    :precondition (and (scout ?r) (at-va ?r) (not (open-a)) (not (short ?r)))
  )

  (:action look-a
    :parameters (?r - agent)
    :action-type (semi-private-sensing (e-look-a-open ?r) (e-look-a-shut ?r))
    :observability-conditions (:and (?r Fully) (default Partially))
  )

  (:event e-look-b-open
    :parameters (?r - agent)
    :precondition (and (scout ?r) (at-vb ?r) (or (open-b) (short ?r)))
  )

  (:event e-look-b-shut
    :parameters (?r - agent)
    :precondition (and (scout ?r) (at-vb ?r) (not (open-b)) (not (short ?r)))
  )

  (:action look-b
    :parameters (?r - agent)
    :action-type (semi-private-sensing (e-look-b-open ?r) (e-look-b-shut ?r))
    :observability-conditions (:and (?r Fully) (default Partially))
  )

  (:event e-look-c-open
    :parameters (?r - agent)
    :precondition (and (scout ?r) (at-vc ?r) (or (open-c) (short ?r)))
  )

  (:event e-look-c-shut
    :parameters (?r - agent)
    :precondition (and (scout ?r) (at-vc ?r) (not (open-c)) (not (short ?r)))
  )

  (:action look-c
    :parameters (?r - agent)
    :action-type (semi-private-sensing (e-look-c-open ?r) (e-look-c-shut ?r))
    :observability-conditions (:and (?r Fully) (default Partially))
  )

  (:event e-look-d-open
    :parameters (?r - agent)
    :precondition (and (scout ?r) (at-vd ?r) (or (open-d) (short ?r)))
  )

  (:event e-look-d-shut
    :parameters (?r - agent)
    :precondition (and (scout ?r) (at-vd ?r) (not (open-d)) (not (short ?r)))
  )

  (:action look-d
    :parameters (?r - agent)
    :action-type (semi-private-sensing (e-look-d-open ?r) (e-look-d-shut ?r))
    :observability-conditions (:and (?r Fully) (default Partially))
  )

  ;;--------------------READINGS AT THE MARK------------------
  ;;
  ;; A scout drives in to the mark before the door, where every laser reads right,
  ;; and out again. Any robot at a mark reads the door there.

  (:event e-advance-a
    :parameters (?r - agent)
    :precondition (and (scout ?r) (at-va ?r))
    :effects (:and (at-ma ?r) (not (at-va ?r)))
  )

  (:action advance-a
    :parameters (?r - agent)
    :action-type (public-ontic (e-advance-a ?r))
    :observability-conditions (default Fully)
  )

  (:event e-check-a-open
    :parameters (?r - agent)
    :precondition (and (at-ma ?r) (open-a))
  )

  (:event e-check-a-shut
    :parameters (?r - agent)
    :precondition (and (at-ma ?r) (not (open-a)))
  )

  (:action check-a
    :parameters (?r - agent)
    :action-type (semi-private-sensing (e-check-a-open ?r) (e-check-a-shut ?r))
    :observability-conditions (:and (?r Fully) (default Partially))
  )

  (:event e-retire-a
    :parameters (?r - agent)
    :precondition (and (scout ?r) (at-ma ?r))
    :effects (:and (at-va ?r) (not (at-ma ?r)))
  )

  (:action retire-a
    :parameters (?r - agent)
    :action-type (public-ontic (e-retire-a ?r))
    :observability-conditions (default Fully)
  )

  (:event e-advance-b
    :parameters (?r - agent)
    :precondition (and (scout ?r) (at-vb ?r))
    :effects (:and (at-mb ?r) (not (at-vb ?r)))
  )

  (:action advance-b
    :parameters (?r - agent)
    :action-type (public-ontic (e-advance-b ?r))
    :observability-conditions (default Fully)
  )

  (:event e-check-b-open
    :parameters (?r - agent)
    :precondition (and (at-mb ?r) (open-b))
  )

  (:event e-check-b-shut
    :parameters (?r - agent)
    :precondition (and (at-mb ?r) (not (open-b)))
  )

  (:action check-b
    :parameters (?r - agent)
    :action-type (semi-private-sensing (e-check-b-open ?r) (e-check-b-shut ?r))
    :observability-conditions (:and (?r Fully) (default Partially))
  )

  (:event e-retire-b
    :parameters (?r - agent)
    :precondition (and (scout ?r) (at-mb ?r))
    :effects (:and (at-vb ?r) (not (at-mb ?r)))
  )

  (:action retire-b
    :parameters (?r - agent)
    :action-type (public-ontic (e-retire-b ?r))
    :observability-conditions (default Fully)
  )

  (:event e-advance-c
    :parameters (?r - agent)
    :precondition (and (scout ?r) (at-vc ?r))
    :effects (:and (at-mc ?r) (not (at-vc ?r)))
  )

  (:action advance-c
    :parameters (?r - agent)
    :action-type (public-ontic (e-advance-c ?r))
    :observability-conditions (default Fully)
  )

  (:event e-check-c-open
    :parameters (?r - agent)
    :precondition (and (at-mc ?r) (open-c))
  )

  (:event e-check-c-shut
    :parameters (?r - agent)
    :precondition (and (at-mc ?r) (not (open-c)))
  )

  (:action check-c
    :parameters (?r - agent)
    :action-type (semi-private-sensing (e-check-c-open ?r) (e-check-c-shut ?r))
    :observability-conditions (:and (?r Fully) (default Partially))
  )

  (:event e-retire-c
    :parameters (?r - agent)
    :precondition (and (scout ?r) (at-mc ?r))
    :effects (:and (at-vc ?r) (not (at-mc ?r)))
  )

  (:action retire-c
    :parameters (?r - agent)
    :action-type (public-ontic (e-retire-c ?r))
    :observability-conditions (default Fully)
  )

  (:event e-advance-d
    :parameters (?r - agent)
    :precondition (and (scout ?r) (at-vd ?r))
    :effects (:and (at-md ?r) (not (at-vd ?r)))
  )

  (:action advance-d
    :parameters (?r - agent)
    :action-type (public-ontic (e-advance-d ?r))
    :observability-conditions (default Fully)
  )

  (:event e-check-d-open
    :parameters (?r - agent)
    :precondition (and (at-md ?r) (open-d))
  )

  (:event e-check-d-shut
    :parameters (?r - agent)
    :precondition (and (at-md ?r) (not (open-d)))
  )

  (:action check-d
    :parameters (?r - agent)
    :action-type (semi-private-sensing (e-check-d-open ?r) (e-check-d-shut ?r))
    :observability-conditions (:and (?r Fully) (default Partially))
  )

  (:event e-retire-d
    :parameters (?r - agent)
    :precondition (and (scout ?r) (at-md ?r))
    :effects (:and (at-vd ?r) (not (at-md ?r)))
  )

  (:action retire-d
    :parameters (?r - agent)
    :action-type (public-ontic (e-retire-d ?r))
    :observability-conditions (default Fully)
  )

  ;;--------------------WHAT IS SAID------------------
  ;;
  ;; A robot says what it read, and every robot hears it: a door read open from a
  ;; mouth (which is the door open, or the reading in error), a door read shut from
  ;; a mouth (the door shut and the reading sound, which is more than the door shut:
  ;; said of a door already known shut, it is news of the laser), a door known shut,
  ;; a door known open.

  (:event e-say-open-a
    :parameters (?r - agent)
    :precondition (and (scout ?r) (or (open-a) (short ?r)) ([?r] (or (open-a) (short ?r))))
  )

  (:event e-say-open-a-else
    :parameters (?r - agent)
    :precondition (not (and (scout ?r) (or (open-a) (short ?r)) ([?r] (or (open-a) (short ?r)))))
  )

  (:action say-open-a
    :parameters (?r - agent)
    :action-type (public-announcement (e-say-open-a ?r) (e-say-open-a-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-say-read-shut-a
    :parameters (?r - agent)
    :precondition (and (scout ?r) (and (not (open-a)) (not (short ?r))) ([?r] (and (not (open-a)) (not (short ?r)))))
  )

  (:event e-say-read-shut-a-else
    :parameters (?r - agent)
    :precondition (not (and (scout ?r) (and (not (open-a)) (not (short ?r))) ([?r] (and (not (open-a)) (not (short ?r))))))
  )

  (:action say-read-shut-a
    :parameters (?r - agent)
    :action-type (public-announcement (e-say-read-shut-a ?r) (e-say-read-shut-a-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-say-shut-a
    :parameters (?r - agent)
    :precondition (and (not (open-a)) ([?r] (not (open-a))))
  )

  (:event e-say-shut-a-else
    :parameters (?r - agent)
    :precondition (not (and (not (open-a)) ([?r] (not (open-a)))))
  )

  (:action say-shut-a
    :parameters (?r - agent)
    :action-type (public-announcement (e-say-shut-a ?r) (e-say-shut-a-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-say-sure-a
    :parameters (?r - agent)
    :precondition (and (open-a) ([?r] (open-a)))
  )

  (:event e-say-sure-a-else
    :parameters (?r - agent)
    :precondition (not (and (open-a) ([?r] (open-a))))
  )

  (:action say-sure-a
    :parameters (?r - agent)
    :action-type (public-announcement (e-say-sure-a ?r) (e-say-sure-a-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-say-open-b
    :parameters (?r - agent)
    :precondition (and (scout ?r) (or (open-b) (short ?r)) ([?r] (or (open-b) (short ?r))))
  )

  (:event e-say-open-b-else
    :parameters (?r - agent)
    :precondition (not (and (scout ?r) (or (open-b) (short ?r)) ([?r] (or (open-b) (short ?r)))))
  )

  (:action say-open-b
    :parameters (?r - agent)
    :action-type (public-announcement (e-say-open-b ?r) (e-say-open-b-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-say-read-shut-b
    :parameters (?r - agent)
    :precondition (and (scout ?r) (and (not (open-b)) (not (short ?r))) ([?r] (and (not (open-b)) (not (short ?r)))))
  )

  (:event e-say-read-shut-b-else
    :parameters (?r - agent)
    :precondition (not (and (scout ?r) (and (not (open-b)) (not (short ?r))) ([?r] (and (not (open-b)) (not (short ?r))))))
  )

  (:action say-read-shut-b
    :parameters (?r - agent)
    :action-type (public-announcement (e-say-read-shut-b ?r) (e-say-read-shut-b-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-say-shut-b
    :parameters (?r - agent)
    :precondition (and (not (open-b)) ([?r] (not (open-b))))
  )

  (:event e-say-shut-b-else
    :parameters (?r - agent)
    :precondition (not (and (not (open-b)) ([?r] (not (open-b)))))
  )

  (:action say-shut-b
    :parameters (?r - agent)
    :action-type (public-announcement (e-say-shut-b ?r) (e-say-shut-b-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-say-sure-b
    :parameters (?r - agent)
    :precondition (and (open-b) ([?r] (open-b)))
  )

  (:event e-say-sure-b-else
    :parameters (?r - agent)
    :precondition (not (and (open-b) ([?r] (open-b))))
  )

  (:action say-sure-b
    :parameters (?r - agent)
    :action-type (public-announcement (e-say-sure-b ?r) (e-say-sure-b-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-say-open-c
    :parameters (?r - agent)
    :precondition (and (scout ?r) (or (open-c) (short ?r)) ([?r] (or (open-c) (short ?r))))
  )

  (:event e-say-open-c-else
    :parameters (?r - agent)
    :precondition (not (and (scout ?r) (or (open-c) (short ?r)) ([?r] (or (open-c) (short ?r)))))
  )

  (:action say-open-c
    :parameters (?r - agent)
    :action-type (public-announcement (e-say-open-c ?r) (e-say-open-c-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-say-read-shut-c
    :parameters (?r - agent)
    :precondition (and (scout ?r) (and (not (open-c)) (not (short ?r))) ([?r] (and (not (open-c)) (not (short ?r)))))
  )

  (:event e-say-read-shut-c-else
    :parameters (?r - agent)
    :precondition (not (and (scout ?r) (and (not (open-c)) (not (short ?r))) ([?r] (and (not (open-c)) (not (short ?r))))))
  )

  (:action say-read-shut-c
    :parameters (?r - agent)
    :action-type (public-announcement (e-say-read-shut-c ?r) (e-say-read-shut-c-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-say-shut-c
    :parameters (?r - agent)
    :precondition (and (not (open-c)) ([?r] (not (open-c))))
  )

  (:event e-say-shut-c-else
    :parameters (?r - agent)
    :precondition (not (and (not (open-c)) ([?r] (not (open-c)))))
  )

  (:action say-shut-c
    :parameters (?r - agent)
    :action-type (public-announcement (e-say-shut-c ?r) (e-say-shut-c-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-say-sure-c
    :parameters (?r - agent)
    :precondition (and (open-c) ([?r] (open-c)))
  )

  (:event e-say-sure-c-else
    :parameters (?r - agent)
    :precondition (not (and (open-c) ([?r] (open-c))))
  )

  (:action say-sure-c
    :parameters (?r - agent)
    :action-type (public-announcement (e-say-sure-c ?r) (e-say-sure-c-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-say-open-d
    :parameters (?r - agent)
    :precondition (and (scout ?r) (or (open-d) (short ?r)) ([?r] (or (open-d) (short ?r))))
  )

  (:event e-say-open-d-else
    :parameters (?r - agent)
    :precondition (not (and (scout ?r) (or (open-d) (short ?r)) ([?r] (or (open-d) (short ?r)))))
  )

  (:action say-open-d
    :parameters (?r - agent)
    :action-type (public-announcement (e-say-open-d ?r) (e-say-open-d-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-say-read-shut-d
    :parameters (?r - agent)
    :precondition (and (scout ?r) (and (not (open-d)) (not (short ?r))) ([?r] (and (not (open-d)) (not (short ?r)))))
  )

  (:event e-say-read-shut-d-else
    :parameters (?r - agent)
    :precondition (not (and (scout ?r) (and (not (open-d)) (not (short ?r))) ([?r] (and (not (open-d)) (not (short ?r))))))
  )

  (:action say-read-shut-d
