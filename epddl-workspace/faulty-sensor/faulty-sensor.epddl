  ;;--------------------THE BED-MOVERS------------------
  ;;
  ;; A bed-mover drives into a passage only when it is sure enough that the door is
  ;; open: believing it, believing it firmly (to degree 2), or knowing it. It cannot
  ;; turn round inside: it crosses a door it knows open, or backs out.

  (:event e-enter-believing-a
    :parameters (?r - agent)
    :precondition (and (mover ?r) (at-va ?r) (or (and (not ([?r] (not (rank0)))) ([?r] (imply (rank0) (open-a)))) (and ([?r] (and (not (rank0)))) (not ([?r] (not (rank1)))) ([?r] (imply (rank1) (open-a)))) (and ([?r] (and (not (rank0)) (not (rank1)))) (not ([?r] (not (rank2)))) ([?r] (imply (rank2) (open-a)))) (and ([?r] (and (not (rank0)) (not (rank1)) (not (rank2)))) (not ([?r] (not (rank3)))) ([?r] (imply (rank3) (open-a)))) (and ([?r] (and (not (rank0)) (not (rank1)) (not (rank2)) (not (rank3)))) (not ([?r] (not (rank4)))) ([?r] (imply (rank4) (open-a)))) (and ([?r] (and (not (rank0)) (not (rank1)) (not (rank2)) (not (rank3)) (not (rank4)))) (not ([?r] (not (rank5)))) ([?r] (imply (rank5) (open-a))))))
    :effects (:and (at-ma ?r) (not (at-va ?r)))
  )

  (:action enter-believing-a
    :parameters (?r - agent)
    :action-type (public-ontic (e-enter-believing-a ?r))
    :observability-conditions (default Fully)
  )

  (:event e-enter-firmly-a
    :parameters (?r - agent)
    :precondition (and (mover ?r) (at-va ?r) (or (and (not ([?r] (not (rank0)))) ([?r] (imply (or (rank0) (rank1)) (open-a)))) (and ([?r] (and (not (rank0)))) (not ([?r] (not (rank1)))) ([?r] (imply (or (rank1) (rank2)) (open-a)))) (and ([?r] (and (not (rank0)) (not (rank1)))) (not ([?r] (not (rank2)))) ([?r] (imply (or (rank2) (rank3)) (open-a)))) (and ([?r] (and (not (rank0)) (not (rank1)) (not (rank2)))) (not ([?r] (not (rank3)))) ([?r] (imply (or (rank3) (rank4)) (open-a)))) (and ([?r] (and (not (rank0)) (not (rank1)) (not (rank2)) (not (rank3)))) (not ([?r] (not (rank4)))) ([?r] (imply (or (rank4) (rank5)) (open-a)))) (and ([?r] (and (not (rank0)) (not (rank1)) (not (rank2)) (not (rank3)) (not (rank4)))) (not ([?r] (not (rank5)))) ([?r] (imply (rank5) (open-a))))))
    :effects (:and (at-ma ?r) (not (at-va ?r)))
  )

  (:action enter-firmly-a
    :parameters (?r - agent)
    :action-type (public-ontic (e-enter-firmly-a ?r))
    :observability-conditions (default Fully)
  )

  (:event e-enter-knowing-a
    :parameters (?r - agent)
    :precondition (and (mover ?r) (at-va ?r) ([?r] (open-a)))
    :effects (:and (at-ma ?r) (not (at-va ?r)))
  )

  (:action enter-knowing-a
    :parameters (?r - agent)
    :action-type (public-ontic (e-enter-knowing-a ?r))
    :observability-conditions (default Fully)
  )

  (:event e-cross-a
    :parameters (?r - agent)
    :precondition (and (mover ?r) (at-ma ?r) (open-a) ([?r] (open-a)))
