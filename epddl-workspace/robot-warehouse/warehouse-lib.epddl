; =============================================================================
; Biblioteca de tipos de acción: warehouse-lib
; Caso de estudio: Multi-Robot Warehouse Inspection
; =============================================================================
;
; Esta biblioteca define los tipos de acción reutilizables para el dominio
; warehouse y dominios similares con robots de roles diferenciados.
;
; Tipos definidos:
;   private         — solo el actor lo sabe (inspección de sensor)
;   basic           — todos observan el mismo evento (movimiento, manipulación)
;   private-channel — solo sender + receptor saben; los demás son ajenos
;
; =============================================================================

(define (action-type-library warehouse-lib)

  (:requirements :partial-observability :events-conditions)

  ; ---------------------------------------------------------------------------
  ; private: solo el actor observa el evento real; los demás son ajenos.
  ; Usado para: inspección de sensores, lecturas locales.
  ; ---------------------------------------------------------------------------
  (:action-type private
    :events              (?e ?nil)
    :observability-types (Fully Oblivious)
    :relations  (Fully     (:forall (?e - event) (?e ?e))
                 Oblivious (:forall (?e - event) (?e ?nil)) )
    :designated (?e)
    :conditions (?e   (:non-trivial-postconditions)
                 ?nil (:trivial-event) )
  )

  ; ---------------------------------------------------------------------------
  ; basic: todos los agentes observan el mismo evento (acciones públicas).
  ; Usado para: movimiento, recoger/depositar piezas, despejar obstáculos,
  ;             activar alarma.
  ; ---------------------------------------------------------------------------
  (:action-type basic
    :events              (?e)
    :observability-types (Fully)
    :relations  (Fully (:forall (?e - event) (?e ?e)))
    :designated (?e)
  )

  ; ---------------------------------------------------------------------------
  ; private-channel: sender y receptor comparten el evento real;
  ; el resto son ajenos (evento nulo).
  ; Usado para: reportes privados entre robots (scout -> supervisor).
  ; ---------------------------------------------------------------------------
  (:action-type private-channel
    :events              (?e ?nil)
    :observability-types (Fully Oblivious)
    :relations  (Fully     (:forall (?e - event) (?e ?e))
                 Oblivious (:forall (?e - event) (?e ?nil)) )
    :designated (?e)
    :conditions (?e   (:non-trivial-postconditions)
                 ?nil (:trivial-event) )
  )

)
