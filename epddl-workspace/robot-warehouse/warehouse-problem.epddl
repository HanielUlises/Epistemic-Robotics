(define (problem warehouse-pickup)

  ;; Two robots on the warehouse floor of scenarios/warehouse.
  ;;
  ;; r1 is at the depot end of the bottom corridor, r2 is waiting at the dock.
  ;; The pallet is in one of the two bays and neither robot knows which, so the
  ;; initial model designates two worlds: one where it is in bay2, one where it
  ;; is in bay3.
  ;;
  ;; The goal asks for two things at once. The pallet has to be at the dock,
  ;; which is ontic and could be had by luck; and r2 has to know which bay it
  ;; came out of, which cannot. r2 never leaves the dock in any plan worth
  ;; finding, so the second conjunct is satisfiable only by r1 going, looking
  ;; and saying so.

  (:domain robot-warehouse)

  (:requirements
    :typing :facts :equality
    :finitary-S5-theories :multi-pointed-models
    :modal-goals :negative-goals :negative-preconditions :knowing-whether
    :list-comprehensions
  )

  (:agents r1 r2)

  (:objects depot bay2 bay3 dock1 - zone)

  (:facts-init
    ;; The bottom corridor of the map: the depot end, the two bay mouths, and
    ;; the way east to the dock.
    (adjacent depot bay2) (adjacent bay2 depot)
    (adjacent bay2 bay3)  (adjacent bay3 bay2)
    (adjacent bay3 dock1) (adjacent dock1 bay3)
    (adjacent depot dock1) (adjacent dock1 depot)
    (bay bay2) (bay bay3)
    (dock dock1)
  )

  (:init
    (:and
      ;; r1 at the depot, r2 already at the dock, and that much is common
      ;; knowledge: the fleet sees its own members move.
      (at-ag r1 depot)
      (not (at-ag r1 bay2)) (not (at-ag r1 bay3)) (not (at-ag r1 dock1))
      (at-ag r2 dock1)
      (not (at-ag r2 depot)) (not (at-ag r2 bay2)) (not (at-ag r2 bay3))
      ([C. All]
        (and (at-ag r1 depot)
             (not (at-ag r1 bay2)) (not (at-ag r1 bay3)) (not (at-ag r1 dock1))
             (at-ag r2 dock1)
             (not (at-ag r2 depot)) (not (at-ag r2 bay2)) (not (at-ag r2 bay3))))

      ;; Nobody is carrying anything and nothing has been delivered.
      (:forall (?i - agent) (not (carrying ?i)))
      (not (delivered))
      ([C. All] (and (forall (?i - agent) (not (carrying ?i))) (not (delivered))))

      ;; The pallet is in exactly one of the two bays, and it is common
      ;; knowledge that it is in one of them -- which bay is the open question.
      ([C. All] (and (or (pallet-at bay2) (pallet-at bay3))
                     (not (and (pallet-at bay2) (pallet-at bay3)))
                     (not (pallet-at depot)) (not (pallet-at dock1))))
      (:forall (?i - agent) ([C. All] (<Kw. ?i> (pallet-at bay2))))
      (:forall (?i - agent) ([C. All] (<Kw. ?i> (pallet-at bay3))))
    )
  )

  (:goal
    (and
      (delivered)
      ([Kw. r2] (pallet-at bay2))
    )
  )
)
