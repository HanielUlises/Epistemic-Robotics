; =============================================================================
; Dominio EPDDL: robot-warehouse
; =============================================================================
; Escenario: Almacén con 3 robots y 4 zonas (Z1..Z4).
;
;   r_scout   — robot explorador: sensa obstáculos y piezas dañadas en privado
;   r_carrier — robot portador:   recoge y transporta piezas
;   r_super   — supervisor:       coordina, anuncia estados a los demás
;
; Zonas: Z1 (entrada), Z2 (estantería-A), Z3 (estantería-B), Z4 (salida)
;
; Predicados de mundo:
;   (at ?r - agent ?z - zone)          robot r está en zona z
;   (obstacle ?z - zone)               hay un obstáculo en z
;   (piece-damaged ?z - zone)          hay una pieza dañada en z
;   (piece-carried ?r - agent)         r lleva una pieza
;   (zone-clear ?z - zone)             la zona no tiene obstáculos
;   (piece-removed ?z - zone)          la pieza dañada fue retirada de z
;   (alarm-raised)                     se activó la alarma general
;
; Predicados epistémicos relevantes (para la meta):
;   ([r_super] (obstacle ?z))          el supervisor sabe que hay obstáculo
;   ([r_super] (piece-removed ?z))     el supervisor sabe que la pieza fue retirada
;   ([C. All] (alarm-raised))          todos saben que la alarma se activó
;
; =============================================================================

(define (domain robot-warehouse)

  (:action-type-libraries intermediate)

  (:requirements
    :lists :equality :list-comprehensions
    :partial-observability :ontic-actions
    :negative-preconditions :modal-preconditions
  )

  ; ---------------------------------------------------------------------------
  ; Tipos (solo agents; zonas se tratarán como constantes en el problema)
  ; ---------------------------------------------------------------------------

  (:predicates
    (at          ?r - agent)          ; zona actual del robot (ver constantes de zona)
    (at-Z1       ?r - agent)
    (at-Z2       ?r - agent)
    (at-Z3       ?r - agent)
    (at-Z4       ?r - agent)
    (obstacle-Z1)                     ; obstáculo en Z1
    (obstacle-Z2)                     ; obstáculo en Z2
    (obstacle-Z3)                     ; obstáculo en Z3
    (piece-damaged-Z2)                ; pieza dañada en Z2
    (piece-damaged-Z3)                ; pieza dañada en Z3
    (piece-carried     ?r - agent)    ; r lleva pieza
    (zone-clear-Z2)                   ; Z2 sin obstáculo
    (zone-clear-Z3)                   ; Z3 sin obstáculo
    (piece-removed-Z2)                ; pieza retirada de Z2
    (piece-removed-Z3)                ; pieza retirada de Z3
    (inspected-Z2      ?r - agent)    ; r inspeccionó Z2
    (inspected-Z3      ?r - agent)    ; r inspeccionó Z3
    (alarm-raised)                    ; alarma activada
    (report-sent       ?r - agent)    ; r envió reporte al supervisor
  )

  (:event nil)

  ; ===========================================================================
  ; EVENTOS — componentes atómicos
  ; ===========================================================================

  ; --- Movimientos públicos (todos ven al robot moverse) --------------------
  ; Cada evento tiene un solo efecto (plank no soporta and/or en eventos).
  ; Movimiento desde Z2 → Z1

  (:event e-move-Z2-to-Z1-arrive
    :parameters (?r - agent)
    :precondition (at-Z2 ?r)
    :effects (at-Z1 ?r)
  )
  (:event e-move-Z2-to-Z1-leave
    :parameters (?r - agent)
    :precondition (at-Z2 ?r)
    :effects (not (at-Z2 ?r))
  )

  ; Movimiento desde Z4 → Z1
  (:event e-move-Z4-to-Z1-arrive
    :parameters (?r - agent)
    :precondition (at-Z4 ?r)
    :effects (at-Z1 ?r)
  )
  (:event e-move-Z4-to-Z1-leave
    :parameters (?r - agent)
    :precondition (at-Z4 ?r)
    :effects (not (at-Z4 ?r))
  )

  ; Movimiento desde Z1 → Z2
  (:event e-move-Z1-to-Z2-arrive
    :parameters (?r - agent)
    :precondition (at-Z1 ?r)
    :effects (at-Z2 ?r)
  )
  (:event e-move-Z1-to-Z2-leave
    :parameters (?r - agent)
    :precondition (at-Z1 ?r)
    :effects (not (at-Z1 ?r))
  )

  ; Movimiento desde Z3 → Z2
  (:event e-move-Z3-to-Z2-arrive
    :parameters (?r - agent)
    :precondition (at-Z3 ?r)
    :effects (at-Z2 ?r)
  )
  (:event e-move-Z3-to-Z2-leave
    :parameters (?r - agent)
    :precondition (at-Z3 ?r)
    :effects (not (at-Z3 ?r))
  )

  ; Movimiento desde Z2 → Z3
  (:event e-move-Z2-to-Z3-arrive
    :parameters (?r - agent)
    :precondition (at-Z2 ?r)
    :effects (at-Z3 ?r)
  )
  (:event e-move-Z2-to-Z3-leave
    :parameters (?r - agent)
    :precondition (at-Z2 ?r)
    :effects (not (at-Z2 ?r))
  )

  ; Movimiento desde Z4 → Z3
  (:event e-move-Z4-to-Z3-arrive
    :parameters (?r - agent)
    :precondition (at-Z4 ?r)
    :effects (at-Z3 ?r)
  )
  (:event e-move-Z4-to-Z3-leave
    :parameters (?r - agent)
    :precondition (at-Z4 ?r)
    :effects (not (at-Z4 ?r))
  )

  ; Movimiento desde Z3 → Z4
  (:event e-move-Z3-to-Z4-arrive
    :parameters (?r - agent)
    :precondition (at-Z3 ?r)
    :effects (at-Z4 ?r)
  )
  (:event e-move-Z3-to-Z4-leave
    :parameters (?r - agent)
    :precondition (at-Z3 ?r)
    :effects (not (at-Z3 ?r))
  )

  ; Movimiento desde Z1 → Z4
  (:event e-move-Z1-to-Z4-arrive
    :parameters (?r - agent)
    :precondition (at-Z1 ?r)
    :effects (at-Z4 ?r)
  )
  (:event e-move-Z1-to-Z4-leave
    :parameters (?r - agent)
    :precondition (at-Z1 ?r)
    :effects (not (at-Z1 ?r))
  )

  ; --- Inspección privada (solo el scout observa) ---------------------------

  (:event e-inspect-Z2
    :parameters (?r - agent)
    :precondition (at-Z2 ?r)
    :effects (inspected-Z2 ?r)
  )

  (:event e-inspect-Z3
    :parameters (?r - agent)
    :precondition (at-Z3 ?r)
    :effects (inspected-Z3 ?r)
  )

  ; --- Recogida de pieza dañada (público: todos ven al carrier recoger) -----

  (:event e-pickup-damaged-Z2-carry
    :parameters (?r - agent)
    :precondition (and (at-Z2 ?r) (piece-damaged-Z2) (not (piece-carried ?r)))
    :effects (piece-carried ?r)
  )

  (:event e-pickup-damaged-Z2-remove
    :parameters (?r - agent)
    :precondition (and (at-Z2 ?r) (piece-damaged-Z2))
    :effects (not (piece-damaged-Z2))
  )
  (:event e-pickup-damaged-Z2-mark
    :parameters (?r - agent)
    :precondition (and (at-Z2 ?r) (piece-damaged-Z2))
    :effects (piece-removed-Z2)
  )

  (:event e-pickup-damaged-Z3-carry
    :parameters (?r - agent)
    :precondition (and (at-Z3 ?r) (piece-damaged-Z3) (not (piece-carried ?r)))
    :effects (piece-carried ?r)
  )

  (:event e-pickup-damaged-Z3-remove
    :parameters (?r - agent)
    :precondition (and (at-Z3 ?r) (piece-damaged-Z3))
    :effects (not (piece-damaged-Z3))
  )
  (:event e-pickup-damaged-Z3-mark
    :parameters (?r - agent)
    :precondition (and (at-Z3 ?r) (piece-damaged-Z3))
    :effects (piece-removed-Z3)
  )

  ; --- Depósito de pieza en zona de salida Z4 (público) --------------------

  (:event e-deposit-Z4
    :parameters (?r - agent)
    :precondition (and (at-Z4 ?r) (piece-carried ?r))
    :effects (not (piece-carried ?r))
  )

  ; --- Eliminar obstáculo (público: todos ven al carrier despejar) ----------

  (:event e-clear-obstacle-Z2-remove
    :parameters (?r - agent)
    :precondition (and (at-Z2 ?r) (obstacle-Z2))
    :effects (not (obstacle-Z2))
  )
  (:event e-clear-obstacle-Z2-mark
    :parameters (?r - agent)
    :precondition (and (at-Z2 ?r) (obstacle-Z2))
    :effects (zone-clear-Z2)
  )

  (:event e-clear-obstacle-Z3-remove
    :parameters (?r - agent)
    :precondition (and (at-Z3 ?r) (obstacle-Z3))
    :effects (not (obstacle-Z3))
  )
  (:event e-clear-obstacle-Z3-mark
    :parameters (?r - agent)
    :precondition (and (at-Z3 ?r) (obstacle-Z3))
    :effects (zone-clear-Z3)
  )

  ; --- Reporte privado: scout le dice al supervisor (anuncio privado) -------

  (:event e-report-obstacle-Z2-to-super
    :parameters (?sender - agent  ?recv - agent)
    :precondition ([?sender] (obstacle-Z2))
  )

  (:event e-report-obstacle-Z3-to-super
    :parameters (?sender - agent  ?recv - agent)
    :precondition ([?sender] (obstacle-Z3))
  )

  (:event e-report-damage-Z2-to-super
    :parameters (?sender - agent  ?recv - agent)
    :precondition ([?sender] (piece-damaged-Z2))
  )

  (:event e-report-damage-Z3-to-super
    :parameters (?sender - agent  ?recv - agent)
    :precondition ([?sender] (piece-damaged-Z3))
  )

  (:event e-mark-report-sent
    :parameters (?r - agent)
    :precondition (not (report-sent ?r))
    :effects (report-sent ?r)
  )

  ; --- Alarma pública: supervisor activa la alarma (conoce daño en Z2 o Z3) -
  ; Dos variantes separadas para evitar 'or' en precondición.

  (:event e-raise-alarm-Z2
    :parameters (?r - agent)
    :precondition (and ([?r] (piece-damaged-Z2)) (not (alarm-raised)))
    :effects (alarm-raised)
  )

  (:event e-raise-alarm-Z3
    :parameters (?r - agent)
    :precondition (and ([?r] (piece-removed-Z3)) (not (alarm-raised)))
    :effects (alarm-raised)
  )

  ; ===========================================================================
  ; ACCIONES
  ; ===========================================================================

  ; --- Movimientos: dos acciones atómicas por arista (arrive + leave) -------
  ; public-ontic solo acepta 1 evento, igual que en box-task.

  (:action move-Z2-to-Z1-arrive
    :parameters (?r - agent)
    :action-type (public-ontic (e-move-Z2-to-Z1-arrive ?r))
    :observability-conditions (default Fully)
  )
  (:action move-Z2-to-Z1-leave
    :parameters (?r - agent)
    :action-type (public-ontic (e-move-Z2-to-Z1-leave ?r))
    :observability-conditions (default Fully)
  )

  (:action move-Z4-to-Z1-arrive
    :parameters (?r - agent)
    :action-type (public-ontic (e-move-Z4-to-Z1-arrive ?r))
    :observability-conditions (default Fully)
  )
  (:action move-Z4-to-Z1-leave
    :parameters (?r - agent)
    :action-type (public-ontic (e-move-Z4-to-Z1-leave ?r))
    :observability-conditions (default Fully)
  )

  (:action move-Z1-to-Z2-arrive
    :parameters (?r - agent)
    :action-type (public-ontic (e-move-Z1-to-Z2-arrive ?r))
    :observability-conditions (default Fully)
  )
  (:action move-Z1-to-Z2-leave
    :parameters (?r - agent)
    :action-type (public-ontic (e-move-Z1-to-Z2-leave ?r))
    :observability-conditions (default Fully)
  )

  (:action move-Z3-to-Z2-arrive
    :parameters (?r - agent)
    :action-type (public-ontic (e-move-Z3-to-Z2-arrive ?r))
    :observability-conditions (default Fully)
  )
  (:action move-Z3-to-Z2-leave
    :parameters (?r - agent)
    :action-type (public-ontic (e-move-Z3-to-Z2-leave ?r))
    :observability-conditions (default Fully)
  )

  (:action move-Z2-to-Z3-arrive
    :parameters (?r - agent)
    :action-type (public-ontic (e-move-Z2-to-Z3-arrive ?r))
    :observability-conditions (default Fully)
  )
  (:action move-Z2-to-Z3-leave
    :parameters (?r - agent)
    :action-type (public-ontic (e-move-Z2-to-Z3-leave ?r))
    :observability-conditions (default Fully)
  )

  (:action move-Z4-to-Z3-arrive
    :parameters (?r - agent)
    :action-type (public-ontic (e-move-Z4-to-Z3-arrive ?r))
    :observability-conditions (default Fully)
  )
  (:action move-Z4-to-Z3-leave
    :parameters (?r - agent)
    :action-type (public-ontic (e-move-Z4-to-Z3-leave ?r))
    :observability-conditions (default Fully)
  )

  (:action move-Z3-to-Z4-arrive
    :parameters (?r - agent)
    :action-type (public-ontic (e-move-Z3-to-Z4-arrive ?r))
    :observability-conditions (default Fully)
  )
  (:action move-Z3-to-Z4-leave
    :parameters (?r - agent)
    :action-type (public-ontic (e-move-Z3-to-Z4-leave ?r))
    :observability-conditions (default Fully)
  )

  (:action move-Z1-to-Z4-arrive
    :parameters (?r - agent)
    :action-type (public-ontic (e-move-Z1-to-Z4-arrive ?r))
    :observability-conditions (default Fully)
  )
  (:action move-Z1-to-Z4-leave
    :parameters (?r - agent)
    :action-type (public-ontic (e-move-Z1-to-Z4-leave ?r))
    :observability-conditions (default Fully)
  )

  ; --- Inspección privada: solo el actor se entera -------------------------

  (:action inspect-private-Z2
    :parameters (?r - agent)
    :action-type (private-ontic (e-inspect-Z2 ?r) (nil))
    :observability-conditions
      (:and
        (?r Fully)
        (default Oblivious)
      )
  )

  (:action inspect-private-Z3
    :parameters (?r - agent)
    :action-type (private-ontic (e-inspect-Z3 ?r) (nil))
    :observability-conditions
      (:and
        (?r Fully)
        (default Oblivious)
      )
  )

  ; --- Recogida de pieza (tres efectos atómicos, tres acciones) -------------

  (:action pickup-damaged-Z2-carry
    :parameters (?r - agent)
    :action-type (public-ontic (e-pickup-damaged-Z2-carry ?r))
    :observability-conditions (default Fully)
  )

  (:action pickup-damaged-Z2-remove
    :parameters (?r - agent)
    :action-type (public-ontic (e-pickup-damaged-Z2-remove ?r))
    :observability-conditions (default Fully)
  )

  (:action pickup-damaged-Z2-mark
    :parameters (?r - agent)
    :action-type (public-ontic (e-pickup-damaged-Z2-mark ?r))
    :observability-conditions (default Fully)
  )

  (:action pickup-damaged-Z3-carry
    :parameters (?r - agent)
    :action-type (public-ontic (e-pickup-damaged-Z3-carry ?r))
    :observability-conditions (default Fully)
  )

  (:action pickup-damaged-Z3-remove
    :parameters (?r - agent)
    :action-type (public-ontic (e-pickup-damaged-Z3-remove ?r))
    :observability-conditions (default Fully)
  )

  (:action pickup-damaged-Z3-mark
    :parameters (?r - agent)
    :action-type (public-ontic (e-pickup-damaged-Z3-mark ?r))
    :observability-conditions (default Fully)
  )

  ; --- Depósito de pieza en Z4 (público) ------------------------------------

  (:action deposit-Z4
    :parameters (?r - agent)
    :action-type (public-ontic (e-deposit-Z4 ?r))
    :observability-conditions (default Fully)
  )

  ; --- Eliminar obstáculo (dos acciones atómicas por zona) ------------------

  (:action clear-obstacle-Z2-remove
    :parameters (?r - agent)
    :action-type (public-ontic (e-clear-obstacle-Z2-remove ?r))
    :observability-conditions (default Fully)
  )

  (:action clear-obstacle-Z2-mark
    :parameters (?r - agent)
    :action-type (public-ontic (e-clear-obstacle-Z2-mark ?r))
    :observability-conditions (default Fully)
  )

  (:action clear-obstacle-Z3-remove
    :parameters (?r - agent)
    :action-type (public-ontic (e-clear-obstacle-Z3-remove ?r))
    :observability-conditions (default Fully)
  )

  (:action clear-obstacle-Z3-mark
    :parameters (?r - agent)
    :action-type (public-ontic (e-clear-obstacle-Z3-mark ?r))
    :observability-conditions (default Fully)
  )

  ; --- Reporte privado scout -> supervisor ----------------------------------

  (:action report-obstacle-Z2
    :parameters (?sender - agent  ?recv - agent)
    :action-type (private-announcement (e-report-obstacle-Z2-to-super ?sender ?recv) (nil))
    :observability-conditions
      (:and
        (?sender Fully)
        (?recv   Fully)
        (default Oblivious)
      )
  )

  (:action report-obstacle-Z3
    :parameters (?sender - agent  ?recv - agent)
    :action-type (private-announcement (e-report-obstacle-Z3-to-super ?sender ?recv) (nil))
    :observability-conditions
      (:and
        (?sender Fully)
        (?recv   Fully)
        (default Oblivious)
      )
  )

  (:action report-damage-Z2
    :parameters (?sender - agent  ?recv - agent)
    :action-type (private-announcement (e-report-damage-Z2-to-super ?sender ?recv) (nil))
    :observability-conditions
      (:and
        (?sender Fully)
        (?recv   Fully)
        (default Oblivious)
      )
  )

  (:action report-damage-Z3
    :parameters (?sender - agent  ?recv - agent)
    :action-type (private-announcement (e-report-damage-Z3-to-super ?sender ?recv) (nil))
    :observability-conditions
      (:and
        (?sender Fully)
        (?recv   Fully)
        (default Oblivious)
      )
  )

  ; --- Activar alarma (público: conocimiento común) -------------------------

  (:action raise-alarm-Z2
    :parameters (?r - agent)
    :action-type (public-ontic (e-raise-alarm-Z2 ?r))
    :observability-conditions (default Fully)
  )

  (:action raise-alarm-Z3
    :parameters (?r - agent)
    :action-type (public-ontic (e-raise-alarm-Z3 ?r))
    :observability-conditions (default Fully)
  )

)
