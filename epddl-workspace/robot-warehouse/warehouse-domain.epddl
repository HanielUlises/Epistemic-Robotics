(define (domain robot-warehouse)

  ;; The warehouse of the RoboticsAcademy multi-robot Amazon exercise, written
  ;; as an epistemic planning domain.
  ;;
  ;; The exercise gives two robots a floor of racks, a pallet to pick up and a
  ;; dock to bring it to, and asks for a task planner that assigns the jobs.
  ;; What it never says is how a robot comes to know *where* the pallet is: a
  ;; centralised planner is simply told, and the robots drive to a coordinate.
  ;;
  ;; Here that is the whole problem. The pallet is in one of two bays, nobody
  ;; knows which, and the only way to find out is to go and look. Looking is
  ;; semi-private -- the fleet sees a robot inspect a bay and does not see what
  ;; it found -- so a second robot that has to know as well has to be told.
  ;;
  ;; The same warehouse is laid out cell by cell in
  ;; scenarios/warehouse/, where the mu-calculus planner routes between the
  ;; zones this domain names. This domain says which zone to be in and what
  ;; must be known there; that one says how to cross the floor to it without
  ;; driving through a corridor nobody has looked into.

  (:requirements
    :typing :facts :equality
    :partial-observability :ontic-actions
    :lists :list-comprehensions
    :negative-preconditions :modal-preconditions :knowing-whether
    :group-modalities :multi-pointed-models
  )

  (:action-type-libraries intermediate)

  (:types zone)

  (:predicates
    (at-ag     ?i - agent ?z - zone)
    (pallet-at ?z - zone)
    (carrying  ?i - agent)
    (delivered)
    ;; Rigid: the floor plan does not change while the robots work.
    (:fact adjacent ?z1 ?z2 - zone)
    (:fact bay      ?z      - zone)
    (:fact dock     ?z      - zone)
  )

  (:event nil)

  ;--------------------DRIVING------------------
  ;
  ; Public: a warehouse fleet tracks where its own members are, and the
  ; exercise's robots publish odometry to each other. Only the pallet is in
  ; doubt, and keeping movement common knowledge is what keeps it that way.

  (:event e-go
    :parameters (?i - agent ?from ?to - zone)
    :precondition
      (and (at-ag ?i ?from) (not (at-ag ?i ?to)) (adjacent ?from ?to))
    :effects
      (:and (not (at-ag ?i ?from)) (at-ag ?i ?to))
  )

  (:action go
    :parameters (?i - agent ?from ?to - zone)
    :action-type (public-ontic (e-go ?i ?from ?to))
    :observability-conditions (default Fully)
  )

  ;--------------------LOOKING------------------
  ;
  ; Semi-private sensing, one event per answer. The precondition asks that the
  ; robot be in the bay and not already know: an inspection that settles
  ; nothing is not an action, it is a no-op with a cost.
  ;
  ; This is the action the perception bridge reports the outcome of. Which of
  ; the two events occurred is a question about the warehouse, not about the
  ; model, and it is answered by whoever did the looking.

  (:event e-inspect-found
    :parameters (?i - agent ?z - zone)
    :precondition
      (and (at-ag ?i ?z) (bay ?z) (pallet-at ?z) (<Kw. ?i> (pallet-at ?z)))
  )

  (:event e-inspect-empty
    :parameters (?i - agent ?z - zone)
    :precondition
      (and (at-ag ?i ?z) (bay ?z) (not (pallet-at ?z)) (<Kw. ?i> (pallet-at ?z)))
  )

  (:action inspect
    :parameters (?i - agent ?z - zone)
    :action-type (semi-private-sensing
      (e-inspect-found ?i ?z)
      (e-inspect-empty ?i ?z) )
    :observability-conditions
      (:and (?i Fully) (default Partially))
  )

  ;--------------------HANDLING------------------
  ;
  ; The modal precondition is the point of the domain: a robot may lift the
  ; pallet only where it *knows* the pallet is. Dropping that conjunct gives
  ; back the classical domain, in which a robot that happens to be standing in
  ; the right bay picks up a pallet it has no reason to believe is there, and
  ; a plan that never inspects anything is valid.

  (:event e-pickup
    :parameters (?i - agent ?z - zone)
    :precondition
      (and (at-ag ?i ?z) (bay ?z) (pallet-at ?z) ([?i] (pallet-at ?z))
           (not (carrying ?i)))
    :effects
      (:and (carrying ?i) (not (pallet-at ?z)))
  )

  (:action pickup
    :parameters (?i - agent ?z - zone)
    :action-type (public-ontic (e-pickup ?i ?z))
    :observability-conditions (default Fully)
  )

  (:event e-unload
    :parameters (?i - agent ?z - zone)
    :precondition (and (at-ag ?i ?z) (dock ?z) (carrying ?i))
    :effects (:and (delivered) (not (carrying ?i)))
  )

  (:action unload
    :parameters (?i - agent ?z - zone)
    :action-type (public-ontic (e-unload ?i ?z))
    :observability-conditions (default Fully)
  )

  ;--------------------REPORTING------------------
  ;
  ; Two announcements per bay, one per answer. A robot can only announce what
  ; it knows, and knowledge is factive, so hearing it settles the bay for the
  ; whole fleet -- which is how the second robot comes to know a thing it
  ; never went to look at.

  (:event e-knows-pallet-at
    :parameters (?i - agent ?z - zone)
    :precondition ([?i] (pallet-at ?z))
  )
  (:event e-not-knows-pallet-at
    :parameters (?i - agent ?z - zone)
    :precondition (not ([?i] (pallet-at ?z)))
  )
  (:action report-pallet-at
    :parameters (?i - agent ?z - zone)
    :action-type (public-announcement
      (e-knows-pallet-at ?i ?z) (e-not-knows-pallet-at ?i ?z) )
    :observability-conditions (default Fully)
  )

  (:event e-knows-pallet-not-at
    :parameters (?i - agent ?z - zone)
    :precondition ([?i] (not (pallet-at ?z)))
  )
  (:event e-not-knows-pallet-not-at
    :parameters (?i - agent ?z - zone)
    :precondition (not ([?i] (not (pallet-at ?z))))
  )
  (:action report-pallet-not-at
    :parameters (?i - agent ?z - zone)
    :action-type (public-announcement
      (e-knows-pallet-not-at ?i ?z) (e-not-knows-pallet-not-at ?i ?z) )
    :observability-conditions (default Fully)
  )
)
