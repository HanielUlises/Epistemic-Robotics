(define (problem rw-1)         ;; Conditional plan: move, scan, then broadcast
    (:domain robot-warehouse)

    (:requirements
        :typing :equality :list-comprehensions
        :finitary-S5-theories :modal-goals :facts
        :knowing-whether :group-modalities
        :disjunctive-preconditions
    )

    (:agents R1 R2)

    (:objects bay1 bay2 bay3 - location)

    (:facts-init
        (adjacent bay1 bay2)
        (adjacent bay2 bay1)
        (adjacent bay2 bay3)
        (adjacent bay3 bay2)
    )

    (:init
        (:and
            ;; Actual state of the warehouse
            (package-at bay2)
            (at R1 bay1) (at R2 bay3)

            ([C. All]
                (and
                    ;; Robot positions are common knowledge
                    (at R1 bay1) (at R2 bay3)
                    (forall (?i - agent ?l1 ?l2 - location | (/= ?l1 ?l2))
                        (imply (at ?i ?l1) (not (at ?i ?l2))) )

                    ;; The package sits in exactly one bay, and never in bay1
                    (not (package-at bay1))
                    (or (package-at bay2) (package-at bay3))
                    (forall (?l1 ?l2 - location | (/= ?l1 ?l2))
                        (imply (package-at ?l1) (not (package-at ?l2))) )))

            ;; Nobody knows which of the two bays holds it
            (:forall (?i - agent)
                ([C. All] (<Kw. ?i> (package-at bay2))) )
        )
    )

    ;; Both robots must end up knowing where the package is, and that must be
    ;; common knowledge between them.
    (:goal
        ([C. All]
            (and
                ([Kw. R1] (package-at bay2))
                ([Kw. R2] (package-at bay2)) ))
    )
)
