;; BELIEF REVISION IN A MIXED FLEET, act 2. Written by tools/model.py.
;; Upper case is a door the porter shut at one; each world's ranks by robot.
;; c ranks by explanation and starts in hd for ward 4, e ranks by knowledge and starts in ht for ward 1
;; takes the word of: e of c
;;   w0: CD  c:0 e:0
;;   w1: AB  c:1 e:0
;;   w2: AC  c:2 e:0
;;   w3: AD  c:2 e:0
;;   w4: BC  c:2 e:0
;;   w5: BD  c:2 e:0

(define (problem act2)
  (:domain mixed-fleet)
  (:requirements :general-frames :multi-pointed-models :modal-goals :negative-preconditions)
  (:agents c e)
  (:init
    :worlds (w0 w1 w2 w3 w4 w5)
    :relations (
      c (:and (w0 w0) (w0 w1) (w0 w2) (w0 w3) (w0 w4) (w0 w5) (w1 w0) (w1 w1) (w1 w2) (w1 w3) (w1 w4) (w1 w5) (w2 w0) (w2 w1) (w2 w2) (w2 w3) (w2 w4) (w2 w5) (w3 w0) (w3 w1) (w3 w2) (w3 w3) (w3 w4) (w3 w5) (w4 w0) (w4 w1) (w4 w2) (w4 w3) (w4 w4) (w4 w5) (w5 w0) (w5 w1) (w5 w2) (w5 w3) (w5 w4) (w5 w5))
      e (:and (w0 w0) (w0 w1) (w0 w2) (w0 w3) (w0 w4) (w0 w5) (w1 w0) (w1 w1) (w1 w2) (w1 w3) (w1 w4) (w1 w5) (w2 w0) (w2 w1) (w2 w2) (w2 w3) (w2 w4) (w2 w5) (w3 w0) (w3 w1) (w3 w2) (w3 w3) (w3 w4) (w3 w5) (w4 w0) (w4 w1) (w4 w2) (w4 w3) (w4 w4) (w4 w5) (w5 w0) (w5 w1) (w5 w2) (w5 w3) (w5 w4) (w5 w5))
    )
    :labels (
      w0 (:and (open-a) (open-b) (rank0 c) (robot c) (at-hd c) (rank0 e) (robot e) (at-ht e) (takes-word e c))
      w1 (:and (open-c) (open-d) (rank1 c) (robot c) (at-hd c) (rank0 e) (robot e) (at-ht e) (takes-word e c))
      w2 (:and (open-b) (open-d) (rank2 c) (robot c) (at-hd c) (rank0 e) (robot e) (at-ht e) (takes-word e c))
      w3 (:and (open-b) (open-c) (rank2 c) (robot c) (at-hd c) (rank0 e) (robot e) (at-ht e) (takes-word e c))
      w4 (:and (open-a) (open-d) (rank2 c) (robot c) (at-hd c) (rank0 e) (robot e) (at-ht e) (takes-word e c))
      w5 (:and (open-a) (open-c) (rank2 c) (robot c) (at-hd c) (rank0 e) (robot e) (at-ht e) (takes-word e c))
    )
    :designated (w0 w1 w2 w3 w4 w5)
  )
  (:goal (and (delivered c) (delivered e)))
)
