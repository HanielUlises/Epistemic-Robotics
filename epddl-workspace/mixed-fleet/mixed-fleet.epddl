  (:event e-seek-sp-vd
    :parameters (?r - agent)
    :precondition (and (searching ?r) (at-sp ?r) (or (not ([?r] (not (and (rank0 ?r) (or (open-d) (open-c) (open-b) (open-a)))))) (and ([?r] (and (not (rank0 ?r)))) (not ([?r] (not (and (rank1 ?r) (or (open-d) (open-c) (open-b) (open-a))))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)))) (not ([?r] (not (and (rank2 ?r) (or (open-d) (open-c) (open-b) (open-a))))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)))) (not ([?r] (not (and (rank3 ?r) (or (open-d) (open-c) (open-b) (open-a))))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)))) (not ([?r] (not (and (rank4 ?r) (or (open-d) (open-c) (open-b) (open-a))))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)))) (not ([?r] (not (and (rank5 ?r) (or (open-d) (open-c) (open-b) (open-a))))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)))) (not ([?r] (not (and (rank6 ?r) (or (open-d) (open-c) (open-b) (open-a))))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)) (not (rank6 ?r)))) (not ([?r] (not (and (rank7 ?r) (or (open-d) (open-c) (open-b) (open-a))))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)) (not (rank6 ?r)) (not (rank7 ?r)))) (not ([?r] (not (and (rank8 ?r) (or (open-d) (open-c) (open-b) (open-a))))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)) (not (rank6 ?r)) (not (rank7 ?r)) (not (rank8 ?r)))) (not ([?r] (not (and (rank9 ?r) (or (open-d) (open-c) (open-b) (open-a)))))))))
    :effects (:and (at-vd ?r) (not (at-sp ?r)))
