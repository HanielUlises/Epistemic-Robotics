;; BELIEF REVISION IN A MIXED FLEET. Written by tools/model.py in
;; mixed_fleet_demo; do not edit by hand.
;;
;; A hospital floor at night. Four fire doors, A to D from west to east, close
;; four lobbies through a band of linen rooms between the hall and the corridor;
;; each lobby turns once, so its door is seen only from a bend inside it. At one
;; the night porter walks a loop, north through one door and south through
;; another, shutting both. Nobody sees him.
;;
;; The fleet is mixed: robots of different makers, each ranking the six loops its
;; own way. Every world carries, for every robot, that robot's Spohn rank of it as
;; a grade atom (rank0 r .. rank8 r). Belief is a formula over knowledge and a
;; robot's own grades: a look or a report of evidence removes worlds, and each
;; robot's least grade among those left says what it believes. A report of
;; belief changes grades: the listener, if it takes the speaker's word, raises
;; its grade of every world the report rules out. Every relation stays an
;; equivalence.

(define (domain mixed-fleet)

  (:requirements
    :equality :partial-observability :ontic-actions :negative-preconditions
    :modal-preconditions :conditional-effects :universal-preconditions :disjunctive-preconditions
  )

  (:action-type-libraries intermediate)

  (:predicates
    (open-a)
    (open-b)
    (open-c)
    (open-d)
    (rank0 ?r - agent)
    (rank1 ?r - agent)
    (rank2 ?r - agent)
    (rank3 ?r - agent)
    (rank4 ?r - agent)
    (rank5 ?r - agent)
    (rank6 ?r - agent)
    (rank7 ?r - agent)
    (rank8 ?r - agent)
    (rank9 ?r - agent)
    (at-hd ?r - agent)
    (at-ht ?r - agent)
    (at-hp ?r - agent)
    (at-va ?r - agent)
    (at-vb ?r - agent)
    (at-st ?r - agent)
    (at-vc ?r - agent)
    (at-vd ?r - agent)
    (at-sp ?r - agent)
    (at-ja ?r - agent)
    (at-jb ?r - agent)
    (at-jc ?r - agent)
    (at-jd ?r - agent)
    (at-na ?r - agent)
    (at-nb ?r - agent)
    (at-nc ?r - agent)
    (at-nd ?r - agent)
    (robot ?r - agent)
    (searching ?r - agent)
    (delivered ?r - agent)
    (takes-word ?l - agent ?s - agent)
  )

  (:event nil)

  ;;--------------------LEAVING THE ROOM------------------

  (:event e-set-out
    :parameters (?r - agent)
    :precondition (and (robot ?r) (not (searching ?r)) (not (delivered ?r)) (or (at-hd ?r) (at-ht ?r) (at-hp ?r)))
    :effects (:and (searching ?r) (when (at-hd ?r) (:and (at-va ?r) (not (at-hd ?r)))) (when (at-ht ?r) (:and (at-st ?r) (not (at-ht ?r)))) (when (at-hp ?r) (:and (at-sp ?r) (not (at-hp ?r)))))
  )

  (:action set-out
    :parameters (?r - agent)
    :action-type (public-ontic (e-set-out ?r))
    :observability-conditions (default Fully)
  )

  ;;--------------------SEEKING------------------
  ;;
  ;; A hop along the hall, only towards a door the robot does not believe shut.

  (:event e-seek-va-vb
    :parameters (?r - agent)
    :precondition (and (searching ?r) (at-va ?r) (or (not ([?r] (not (and (rank0 ?r) (or (open-b) (open-c) (open-d)))))) (and ([?r] (and (not (rank0 ?r)))) (not ([?r] (not (and (rank1 ?r) (or (open-b) (open-c) (open-d))))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)))) (not ([?r] (not (and (rank2 ?r) (or (open-b) (open-c) (open-d))))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)))) (not ([?r] (not (and (rank3 ?r) (or (open-b) (open-c) (open-d))))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)))) (not ([?r] (not (and (rank4 ?r) (or (open-b) (open-c) (open-d))))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)))) (not ([?r] (not (and (rank5 ?r) (or (open-b) (open-c) (open-d))))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)))) (not ([?r] (not (and (rank6 ?r) (or (open-b) (open-c) (open-d))))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)) (not (rank6 ?r)))) (not ([?r] (not (and (rank7 ?r) (or (open-b) (open-c) (open-d))))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)) (not (rank6 ?r)) (not (rank7 ?r)))) (not ([?r] (not (and (rank8 ?r) (or (open-b) (open-c) (open-d))))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)) (not (rank6 ?r)) (not (rank7 ?r)) (not (rank8 ?r)))) (not ([?r] (not (and (rank9 ?r) (or (open-b) (open-c) (open-d)))))))))
    :effects (:and (at-vb ?r) (not (at-va ?r)))
  )

  (:action seek-va-vb
    :parameters (?r - agent)
    :action-type (public-ontic (e-seek-va-vb ?r))
    :observability-conditions (default Fully)
  )

  (:event e-seek-vb-va
    :parameters (?r - agent)
    :precondition (and (searching ?r) (at-vb ?r) (or (not ([?r] (not (and (rank0 ?r) (open-a))))) (and ([?r] (and (not (rank0 ?r)))) (not ([?r] (not (and (rank1 ?r) (open-a)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)))) (not ([?r] (not (and (rank2 ?r) (open-a)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)))) (not ([?r] (not (and (rank3 ?r) (open-a)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)))) (not ([?r] (not (and (rank4 ?r) (open-a)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)))) (not ([?r] (not (and (rank5 ?r) (open-a)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)))) (not ([?r] (not (and (rank6 ?r) (open-a)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)) (not (rank6 ?r)))) (not ([?r] (not (and (rank7 ?r) (open-a)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)) (not (rank6 ?r)) (not (rank7 ?r)))) (not ([?r] (not (and (rank8 ?r) (open-a)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)) (not (rank6 ?r)) (not (rank7 ?r)) (not (rank8 ?r)))) (not ([?r] (not (and (rank9 ?r) (open-a))))))))
    :effects (:and (at-va ?r) (not (at-vb ?r)))
  )

