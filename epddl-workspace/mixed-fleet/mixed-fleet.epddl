  ;;--------------------REPORTS OF EVIDENCE------------------
  ;;
  ;; A robot reports a door it knows to be shut. Every robot hears it.

  (:event e-tell-a
    :parameters (?r - agent)
    :precondition (and (robot ?r) (not (open-a)) ([?r] (not (open-a))))
  )

  (:event e-tell-a-else
    :parameters (?r - agent)
    :precondition (not (and (robot ?r) (not (open-a)) ([?r] (not (open-a)))))
  )

  (:action tell-a
    :parameters (?r - agent)
    :action-type (public-announcement (e-tell-a ?r) (e-tell-a-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-tell-b
    :parameters (?r - agent)
    :precondition (and (robot ?r) (not (open-b)) ([?r] (not (open-b))))
  )

  (:event e-tell-b-else
    :parameters (?r - agent)
    :precondition (not (and (robot ?r) (not (open-b)) ([?r] (not (open-b)))))
  )

  (:action tell-b
    :parameters (?r - agent)
    :action-type (public-announcement (e-tell-b ?r) (e-tell-b-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-tell-c
    :parameters (?r - agent)
    :precondition (and (robot ?r) (not (open-c)) ([?r] (not (open-c))))
  )

  (:event e-tell-c-else
    :parameters (?r - agent)
    :precondition (not (and (robot ?r) (not (open-c)) ([?r] (not (open-c)))))
  )

  (:action tell-c
    :parameters (?r - agent)
    :action-type (public-announcement (e-tell-c ?r) (e-tell-c-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-tell-d
    :parameters (?r - agent)
    :precondition (and (robot ?r) (not (open-d)) ([?r] (not (open-d))))
  )

  (:event e-tell-d-else
    :parameters (?r - agent)
    :precondition (not (and (robot ?r) (not (open-d)) ([?r] (not (open-d)))))
  )

  (:action tell-d
    :parameters (?r - agent)
    :action-type (public-announcement (e-tell-d ?r) (e-tell-d-else ?r))
    :observability-conditions (default Fully)
  )

  ;;--------------------REPORTS OF BELIEF------------------
  ;;
  ;; Robot ?s says it believes a door shut (or open): it believes so, does not know it,
  ;; and believes that ?l, which takes its word and is still searching, does not
  ;; believe it. Every robot hears it; ?l's grade rises by the trust in every world
  ;; the report rules out.

