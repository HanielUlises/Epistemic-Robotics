  ;;--------------------THE LOBBIES------------------
  ;;
  ;; In to the bend from which the door is seen, only if the robot does not believe
  ;; it shut; a look from the bend; back out to the mouth; through, knowing it open.

  (:event e-enter-a-s
    :parameters (?r - agent)
    :precondition (and (searching ?r) (at-va ?r) (or (not ([?r] (not (and (rank0 ?r) (open-a))))) (and ([?r] (and (not (rank0 ?r)))) (not ([?r] (not (and (rank1 ?r) (open-a)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)))) (not ([?r] (not (and (rank2 ?r) (open-a)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)))) (not ([?r] (not (and (rank3 ?r) (open-a)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)))) (not ([?r] (not (and (rank4 ?r) (open-a)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)))) (not ([?r] (not (and (rank5 ?r) (open-a)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)))) (not ([?r] (not (and (rank6 ?r) (open-a)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)) (not (rank6 ?r)))) (not ([?r] (not (and (rank7 ?r) (open-a)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)) (not (rank6 ?r)) (not (rank7 ?r)))) (not ([?r] (not (and (rank8 ?r) (open-a)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)) (not (rank6 ?r)) (not (rank7 ?r)) (not (rank8 ?r)))) (not ([?r] (not (and (rank9 ?r) (open-a))))))))
    :effects (:and (at-ja ?r) (not (at-va ?r)))
  )

  (:action enter-a-s
    :parameters (?r - agent)
    :action-type (public-ontic (e-enter-a-s ?r))
    :observability-conditions (default Fully)
  )

  (:event e-look-a-s-open
    :parameters (?r - agent)
    :precondition (and (at-ja ?r) (open-a))
  )

  (:event e-look-a-s-shut
    :parameters (?r - agent)
    :precondition (and (at-ja ?r) (not (open-a)))
  )

  (:action look-a-s
    :parameters (?r - agent)
    :action-type (semi-private-sensing (e-look-a-s-open ?r) (e-look-a-s-shut ?r))
    :observability-conditions (:and (?r Fully) (default Partially))
  )

  (:event e-back-a-s
    :parameters (?r - agent)
    :precondition (and (robot ?r) (at-ja ?r))
    :effects (:and (at-va ?r) (not (at-ja ?r)))
  )

  (:action back-a-s
    :parameters (?r - agent)
    :action-type (public-ontic (e-back-a-s ?r))
    :observability-conditions (default Fully)
  )

  (:event e-cross-a-n
    :parameters (?r - agent)
    :precondition (and (searching ?r) (at-ja ?r) (open-a) ([?r] (open-a)))
    :effects (:and (at-na ?r) (not (at-ja ?r)) (not (searching ?r)))
  )

