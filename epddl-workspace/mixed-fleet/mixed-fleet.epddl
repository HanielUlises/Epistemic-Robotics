    :precondition (and (searching ?r) (at-vb ?r) (or (not ([?r] (not (and (rank0 ?r) (open-b))))) (and ([?r] (and (not (rank0 ?r)))) (not ([?r] (not (and (rank1 ?r) (open-b)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)))) (not ([?r] (not (and (rank2 ?r) (open-b)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)))) (not ([?r] (not (and (rank3 ?r) (open-b)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)))) (not ([?r] (not (and (rank4 ?r) (open-b)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)))) (not ([?r] (not (and (rank5 ?r) (open-b)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)))) (not ([?r] (not (and (rank6 ?r) (open-b)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)) (not (rank6 ?r)))) (not ([?r] (not (and (rank7 ?r) (open-b)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)) (not (rank6 ?r)) (not (rank7 ?r)))) (not ([?r] (not (and (rank8 ?r) (open-b)))))) (and ([?r] (and (not (rank0 ?r)) (not (rank1 ?r)) (not (rank2 ?r)) (not (rank3 ?r)) (not (rank4 ?r)) (not (rank5 ?r)) (not (rank6 ?r)) (not (rank7 ?r)) (not (rank8 ?r)))) (not ([?r] (not (and (rank9 ?r) (open-b))))))))
