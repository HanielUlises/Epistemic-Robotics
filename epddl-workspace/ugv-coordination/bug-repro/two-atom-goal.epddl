(define (problem repro2)
    (:domain ugv-facility)
    (:requirements :typing :equality :list-comprehensions
        :finitary-S5-theories :modal-goals :facts :knowing-whether
        :group-modalities :disjunctive-preconditions)
    (:agents R1 R2)
    (:objects b1 b2 b3 - location  o1 o2 - item)
    (:facts-init
        (adjacent b1 b2) (adjacent b2 b1) (adjacent b2 b3) (adjacent b3 b2)
        (has-scanner R1) (keyholder R2))
    (:init
        (:and
            (at R1 b1) (at R2 b1)
            ([C. All]
                (and
                    (at R1 b1) (at R2 b1)
                    (forall (?l - location) (not (locked ?l)))
                    (forall (?i - agent ?l1 ?l2 - location | (/= ?l1 ?l2))
                        (imply (at ?i ?l1) (not (at ?i ?l2))) )
                    (not (item-at o1 b1))
                    (or (item-at o1 b2) (item-at o1 b3))
                    (forall (?l1 ?l2 - location | (/= ?l1 ?l2))
                        (imply (item-at o1 ?l1) (not (item-at o1 ?l2))) )
                    (not (item-at o2 b3))
                    (or (item-at o2 b1) (item-at o2 b2))
                    (forall (?l1 ?l2 - location | (/= ?l1 ?l2))
                        (imply (item-at o2 ?l1) (not (item-at o2 ?l2))) )))
            (:forall (?i - agent) ([C. All] (<Kw. ?i> (item-at o1 b2))) )
            (:forall (?i - agent) ([C. All] (<Kw. ?i> (item-at o2 b1))) )))
    (:goal
        ([C. All]
            (and
                ([Kw. R1] (item-at o1 b2))
                ([Kw. R2] (item-at o1 b2))
                ([Kw. R1] (item-at o2 b1))
                ([Kw. R2] (item-at o2 b1)) ))
    )
)
