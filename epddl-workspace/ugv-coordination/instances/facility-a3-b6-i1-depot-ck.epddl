(define (problem facility-a3-b6-i1-depot-ck)
    ;; 3 UGVs: R1 carries the detector, R2 the key. 6 bays with
    ;; b3 locked, 1 item(s) to localise. Fleet-wide common-knowledge goal.
    (:domain ugv-facility)

    (:requirements
        :typing :equality :list-comprehensions
        :finitary-S5-theories :modal-goals :facts
        :knowing-whether :group-modalities
        :disjunctive-preconditions
    )

    (:agents R1 R2 R3)

    (:objects
        b1 b2 b3 b4 b5 b6 - location
        o1 - item
    )

    (:facts-init
        (adjacent b1 b2)
        (adjacent b2 b1)
        (adjacent b2 b3)
        (adjacent b3 b2)
        (adjacent b3 b4)
        (adjacent b4 b3)
        (adjacent b4 b5)
        (adjacent b5 b4)
        (adjacent b5 b6)
        (adjacent b6 b5)
        (has-scanner R1)
        (keyholder R2)
    )

    (:init
        (:and
            (at R1 b1) (at R2 b1) (at R3 b1)
            (locked b3)

            ([C. All]
                (and
                    (at R1 b1) (at R2 b1) (at R3 b1)
                    (locked b3)
                    (forall (?l - location | (/= ?l b3)) (not (locked ?l)))
                    (forall (?i - agent ?l1 ?l2 - location | (/= ?l1 ?l2))
                        (imply (at ?i ?l1) (not (at ?i ?l2))) )

                    (not (item-at o1 b1))
                    (not (item-at o1 b2))
                    (not (item-at o1 b3))
                    (not (item-at o1 b4))
                    (or (item-at o1 b6) (item-at o1 b5))
                    (forall (?l1 ?l2 - location | (/= ?l1 ?l2))
                        (imply (item-at o1 ?l1) (not (item-at o1 ?l2))) )))

            (:forall (?i - agent)
                ([C. All] (<Kw. ?i> (item-at o1 b6))) )
        )
    )

    (:goal
        ([C. All]
            (and
                ([Kw. R1] (item-at o1 b6))
                ([Kw. R2] (item-at o1 b6))
                ([Kw. R3] (item-at o1 b6)) ))
    )
)
