(define (problem public-a4-b6-u4-spread-ck)
    ;; 4 UGVs, 6 bays, target in one of 4 candidate bays, spread start,
    ;; fleet-wide common knowledge goal.
    (:domain ugv-public)

    (:requirements
        :typing :equality :list-comprehensions
        :finitary-S5-theories :modal-goals :facts
        :knowing-whether :group-modalities
        :disjunctive-preconditions
    )

    (:agents R1 R2 R3 R4)

    (:objects b1 b2 b3 b4 b5 b6 - location)

    (:facts-init
        (adjacent b1 b2)
        (adjacent b2 b1)
        (adjacent b2 b3)
        (adjacent b3 b2)
        (adjacent b3 b4)
        (adjacent b4 b3)
        (adjacent b4 b5)
        (adjacent b5 b4)
        (adjacent b5 b6)
        (adjacent b6 b5)
    )

    ;; The true bay is left open, so every candidate world stays designated and
    ;; the plan must succeed whichever way the scans come out.
    (:init
        (:and
            (at R1 b1) (at R2 b2) (at R3 b3) (at R4 b4)

            ([C. All]
                (and
                    (at R1 b1) (at R2 b2) (at R3 b3) (at R4 b4)
                    (forall (?i - agent ?l1 ?l2 - location | (/= ?l1 ?l2))
                        (imply (at ?i ?l1) (not (at ?i ?l2))) )

                    (not (target-at b1))
                    (not (target-at b2))
                    (or (target-at b3) (target-at b4) (target-at b5) (target-at b6))
                    (forall (?l1 ?l2 - location | (/= ?l1 ?l2))
                        (imply (target-at ?l1) (not (target-at ?l2))) )))

            (:forall (?i - agent)
                ([C. All] (<Kw. ?i> (target-at b3))) )
        )
    )

    (:goal
        ([C. All]
            (and
                ([Kw. R1] (target-at b3))
                ([Kw. R2] (target-at b3))
                ([Kw. R3] (target-at b3))
                ([Kw. R4] (target-at b3)) ))
    )
)
