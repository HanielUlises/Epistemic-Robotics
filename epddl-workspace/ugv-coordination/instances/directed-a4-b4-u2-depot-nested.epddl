(define (problem directed-a4-b4-u2-depot-nested)
    ;; 4 UGVs (R1 is the only one with a detector), 4 bays, target in one
    ;; of 2 candidate bays, depot start, nested goal.
    (:domain ugv-directed)

    (:requirements
        :typing :equality :list-comprehensions
        :finitary-S5-theories :modal-goals :facts
        :knowing-whether :group-modalities
        :disjunctive-preconditions
    )

    (:agents R1 R2 R3 R4)

    (:objects b1 b2 b3 b4 - location)

    (:facts-init
        (adjacent b1 b2)
        (adjacent b2 b1)
        (adjacent b2 b3)
        (adjacent b3 b2)
        (adjacent b3 b4)
        (adjacent b4 b3)
        (has-scanner R1)
    )

    (:init
        (:and
            (at R1 b1) (at R2 b1) (at R3 b1) (at R4 b1)

            ([C. All]
                (and
                    (at R1 b1) (at R2 b1) (at R3 b1) (at R4 b1)
                    (forall (?i - agent ?l1 ?l2 - location | (/= ?l1 ?l2))
                        (imply (at ?i ?l1) (not (at ?i ?l2))) )

                    (not (target-at b1))
                    (not (target-at b2))
                    (or (target-at b3) (target-at b4))
                    (forall (?l1 ?l2 - location | (/= ?l1 ?l2))
                        (imply (target-at ?l1) (not (target-at ?l2))) )))

            (:forall (?i - agent)
                ([C. All] (<Kw. ?i> (target-at b3))) )
        )
    )

    (:goal
        ([R1] ([Kw. R2] (target-at b3)))
    )
)
