(define (problem radio-a4-b4-u2-spread-nested)
    ;; 4 UGVs, 4 bays, target in one of 2 candidate bays, spread start,
    ;; second-order goal.
    (:domain ugv-radio)

    (:requirements
        :typing :equality :list-comprehensions
        :finitary-S5-theories :modal-goals :facts
        :knowing-whether :group-modalities
        :disjunctive-preconditions
    )

    (:agents R1 R2 R3 R4)

    (:objects b1 b2 b3 b4 - location)

    (:facts-init
        (adjacent b1 b2)
        (adjacent b2 b1)
        (adjacent b2 b3)
        (adjacent b3 b2)
        (adjacent b3 b4)
        (adjacent b4 b3)
    )

    ;; The true bay is left open, so every candidate world stays designated and
    ;; the plan must succeed whichever way the scans come out.
    (:init
        (:and
            (at R1 b1) (at R2 b2) (at R3 b3) (at R4 b4)

            ([C. All]
                (and
                    (at R1 b1) (at R2 b2) (at R3 b3) (at R4 b4)
                    (forall (?i - agent ?l1 ?l2 - location | (/= ?l1 ?l2))
                        (imply (at ?i ?l1) (not (at ?i ?l2))) )

                    (not (target-at b1))
                    (not (target-at b2))
                    (or (target-at b3) (target-at b4))
                    (forall (?l1 ?l2 - location | (/= ?l1 ?l2))
                        (imply (target-at ?l1) (not (target-at ?l2))) )))

            (:forall (?i - agent)
                ([C. All] (<Kw. ?i> (target-at b3))) )
        )
    )

    (:goal
        ([R1] ([Kw. R2] (target-at b3)))
    )
)
