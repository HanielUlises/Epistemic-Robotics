    :precondition (and (courier ?r) (out ?r) (at-vb ?r) (or (not ([?r] (not (and (g0) (or (open-c) (open-d)))))) (and ([?r] (and (not (g0)))) (not ([?r] (not (and (g1) (or (open-c) (open-d))))))) (and ([?r] (and (not (g0)) (not (g1)))) (not ([?r] (not (and (g2) (or (open-c) (open-d))))))) (and ([?r] (and (not (g0)) (not (g1)) (not (g2)))) (not ([?r] (not (and (g3) (or (open-c) (open-d))))))) (and ([?r] (and (not (g0)) (not (g1)) (not (g2)) (not (g3)))) (not ([?r] (not (and (g4) (or (open-c) (open-d))))))) (and ([?r] (and (not (g0)) (not (g1)) (not (g2)) (not (g3)) (not (g4)))) (not ([?r] (not (and (g5) (or (open-c) (open-d))))))) (and ([?r] (and (not (g0)) (not (g1)) (not (g2)) (not (g3)) (not (g4)) (not (g5)))) (not ([?r] (not (and (g6) (or (open-c) (open-d)))))))))
