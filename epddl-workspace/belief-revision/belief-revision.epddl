  (:event e-enter-d-n
    :parameters (?r - agent)
    :precondition (and (courier ?r) (back ?r) (at-nd ?r) (or (not ([?r] (not (and (g0) (open-d))))) (and ([?r] (and (not (g0)))) (not ([?r] (not (and (g1) (open-d)))))) (and ([?r] (and (not (g0)) (not (g1)))) (not ([?r] (not (and (g2) (open-d)))))) (and ([?r] (and (not (g0)) (not (g1)) (not (g2)))) (not ([?r] (not (and (g3) (open-d)))))) (and ([?r] (and (not (g0)) (not (g1)) (not (g2)) (not (g3)))) (not ([?r] (not (and (g4) (open-d)))))) (and ([?r] (and (not (g0)) (not (g1)) (not (g2)) (not (g3)) (not (g4)))) (not ([?r] (not (and (g5) (open-d)))))) (and ([?r] (and (not (g0)) (not (g1)) (not (g2)) (not (g3)) (not (g4)) (not (g5)))) (not ([?r] (not (and (g6) (open-d))))))))
    :effects (:and (at-kd ?r) (not (at-nd ?r)))
  )

  (:action enter-d-n
    :parameters (?r - agent)
    :action-type (public-ontic (e-enter-d-n ?r))
    :observability-conditions (default Fully)
  )

  (:event e-look-d-n-open
    :parameters (?r - agent)
    :precondition (and (at-kd ?r) (open-d))
  )

  (:event e-look-d-n-shut
    :parameters (?r - agent)
    :precondition (and (at-kd ?r) (not (open-d)))
  )

  (:action look-d-n
    :parameters (?r - agent)
    :action-type (semi-private-sensing (e-look-d-n-open ?r) (e-look-d-n-shut ?r))
    :observability-conditions (:and (?r Fully) (default Partially))
  )

  (:event e-back-d-n
    :parameters (?r - agent)
    :precondition (and (courier ?r) (at-kd ?r))
    :effects (:and (at-nd ?r) (not (at-kd ?r)))
  )

  (:action back-d-n
    :parameters (?r - agent)
    :action-type (public-ontic (e-back-d-n ?r))
    :observability-conditions (default Fully)
  )

  (:event e-cross-d-n
    :parameters (?r - agent)
    :precondition (and (courier ?r) (out ?r) (at-jd ?r) (open-d) ([?r] (open-d)))
    :effects (:and (at-nd ?r) (not (at-jd ?r)))
  )

  (:action cross-d-n
    :parameters (?r - agent)
    :action-type (public-ontic (e-cross-d-n ?r))
    :observability-conditions (default Fully)
  )

  (:event e-cross-d-s
    :parameters (?r - agent)
    :precondition (and (courier ?r) (back ?r) (at-kd ?r) (open-d) ([?r] (open-d)))
    :effects (:and (at-vd ?r) (not (at-kd ?r)))
  )

  (:action cross-d-s
    :parameters (?r - agent)
    :action-type (public-ontic (e-cross-d-s ?r))
    :observability-conditions (default Fully)
  )

  ;;--------------------WALKING ON------------------

  (:event e-walk-nw-na
    :parameters (?r - agent)
    :precondition (and (courier ?r) (out ?r) (at-nw ?r))
    :effects (:and (at-na ?r) (not (at-nw ?r)))
  )

  (:action walk-nw-na
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-nw-na ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-na-nw
    :parameters (?r - agent)
    :precondition (and (courier ?r) (out ?r) (at-na ?r))
    :effects (:and (at-nw ?r) (not (at-na ?r)))
  )

  (:action walk-na-nw
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-na-nw ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-na-nb
    :parameters (?r - agent)
    :precondition (and (courier ?r) (out ?r) (at-na ?r))
    :effects (:and (at-nb ?r) (not (at-na ?r)))
  )

  (:action walk-na-nb
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-na-nb ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-nb-na
    :parameters (?r - agent)
    :precondition (and (courier ?r) (out ?r) (at-nb ?r))
    :effects (:and (at-na ?r) (not (at-nb ?r)))
  )

  (:action walk-nb-na
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-nb-na ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-nb-nc
    :parameters (?r - agent)
    :precondition (and (courier ?r) (out ?r) (at-nb ?r))
    :effects (:and (at-nc ?r) (not (at-nb ?r)))
  )

  (:action walk-nb-nc
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-nb-nc ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-nc-nb
    :parameters (?r - agent)
    :precondition (and (courier ?r) (out ?r) (at-nc ?r))
    :effects (:and (at-nb ?r) (not (at-nc ?r)))
  )

  (:action walk-nc-nb
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-nc-nb ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-nc-nd
    :parameters (?r - agent)
    :precondition (and (courier ?r) (out ?r) (at-nc ?r))
    :effects (:and (at-nd ?r) (not (at-nc ?r)))
  )

  (:action walk-nc-nd
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-nc-nd ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-nd-nc
    :parameters (?r - agent)
    :precondition (and (courier ?r) (out ?r) (at-nd ?r))
    :effects (:and (at-nc ?r) (not (at-nd ?r)))
  )

  (:action walk-nd-nc
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-nd-nc ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-va-vb
    :parameters (?r - agent)
    :precondition (and (courier ?r) (back ?r) (at-va ?r))
    :effects (:and (at-vb ?r) (not (at-va ?r)))
  )

  (:action walk-va-vb
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-va-vb ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-vb-va
    :parameters (?r - agent)
    :precondition (and (courier ?r) (back ?r) (at-vb ?r))
    :effects (:and (at-va ?r) (not (at-vb ?r)))
  )

  (:action walk-vb-va
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-vb-va ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-vb-st
    :parameters (?r - agent)
    :precondition (and (courier ?r) (back ?r) (at-vb ?r))
    :effects (:and (at-st ?r) (not (at-vb ?r)))
  )

  (:action walk-vb-st
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-vb-st ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-st-vb
    :parameters (?r - agent)
    :precondition (and (courier ?r) (back ?r) (at-st ?r))
    :effects (:and (at-vb ?r) (not (at-st ?r)))
  )

  (:action walk-st-vb
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-st-vb ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-st-vc
    :parameters (?r - agent)
    :precondition (and (courier ?r) (back ?r) (at-st ?r))
    :effects (:and (at-vc ?r) (not (at-st ?r)))
  )

  (:action walk-st-vc
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-st-vc ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-vc-st
    :parameters (?r - agent)
    :precondition (and (courier ?r) (back ?r) (at-vc ?r))
    :effects (:and (at-st ?r) (not (at-vc ?r)))
  )

  (:action walk-vc-st
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-vc-st ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-vc-vd
    :parameters (?r - agent)
    :precondition (and (courier ?r) (back ?r) (at-vc ?r))
    :effects (:and (at-vd ?r) (not (at-vc ?r)))
  )

  (:action walk-vc-vd
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-vc-vd ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-vd-vc
    :parameters (?r - agent)
    :precondition (and (courier ?r) (back ?r) (at-vd ?r))
    :effects (:and (at-vc ?r) (not (at-vd ?r)))
  )

  (:action walk-vd-vc
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-vd-vc ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-vd-sp
    :parameters (?r - agent)
    :precondition (and (courier ?r) (back ?r) (at-vd ?r))
    :effects (:and (at-sp ?r) (not (at-vd ?r)))
  )

  (:action walk-vd-sp
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-vd-sp ?r))
    :observability-conditions (default Fully)
  )

  (:event e-walk-sp-vd
    :parameters (?r - agent)
    :precondition (and (courier ?r) (back ?r) (at-sp ?r))
    :effects (:and (at-vd ?r) (not (at-sp ?r)))
  )

  (:action walk-sp-vd
    :parameters (?r - agent)
    :action-type (public-ontic (e-walk-sp-vd ?r))
    :observability-conditions (default Fully)
  )

  (:event e-deliver
    :parameters (?r - agent)
    :precondition (and (courier ?r) (out ?r) (or (and (bed-rc ?r) (at-nw ?r)) (and (bed-rd ?r) (at-nb ?r))))
    :effects (:and (delivered ?r) (when (at-nw ?r) (:and (at-rc ?r) (not (at-nw ?r)))) (when (at-nb ?r) (:and (at-rd ?r) (not (at-nb ?r)))))
  )

  (:action deliver
    :parameters (?r - agent)
    :action-type (public-ontic (e-deliver ?r))
    :observability-conditions (default Fully)
  )

  (:event e-leave
    :parameters (?r - agent)
    :precondition (and (courier ?r) (out ?r) (delivered ?r) (round-done))
    :effects (:and (back ?r) (not (out ?r)) (when (at-rc ?r) (:and (at-nw ?r) (not (at-rc ?r)))) (when (at-rd ?r) (:and (at-nb ?r) (not (at-rd ?r)))))
  )

  (:action leave
    :parameters (?r - agent)
    :action-type (public-ontic (e-leave ?r))
    :observability-conditions (default Fully)
  )

  (:event e-arrive
    :parameters (?r - agent)
    :precondition (and (courier ?r) (back ?r) (or (and (lives-hc ?r) (at-sp ?r)) (and (lives-ht ?r) (at-st ?r))))
    :effects (:and (home ?r) (when (at-sp ?r) (:and (at-hc ?r) (not (at-sp ?r)))) (when (at-st ?r) (:and (at-ht ?r) (not (at-st ?r)))))
  )

  (:action arrive
    :parameters (?r - agent)
    :action-type (public-ontic (e-arrive ?r))
    :observability-conditions (default Fully)
  )

  ;;--------------------THE RADIO------------------
  ;;
  ;; A robot reports a door it knows to be shut. Every robot hears it.

  (:event e-tell-a
    :parameters (?r - agent)
    :precondition (and (courier ?r) (not (open-a)) ([?r] (not (open-a))))
  )

  (:event e-tell-a-else
    :parameters (?r - agent)
    :precondition (not (and (courier ?r) (not (open-a)) ([?r] (not (open-a)))))
  )

  (:action tell-a
    :parameters (?r - agent)
    :action-type (public-announcement (e-tell-a ?r) (e-tell-a-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-tell-b
    :parameters (?r - agent)
    :precondition (and (courier ?r) (not (open-b)) ([?r] (not (open-b))))
  )

  (:event e-tell-b-else
    :parameters (?r - agent)
    :precondition (not (and (courier ?r) (not (open-b)) ([?r] (not (open-b)))))
  )

  (:action tell-b
    :parameters (?r - agent)
    :action-type (public-announcement (e-tell-b ?r) (e-tell-b-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-tell-c
    :parameters (?r - agent)
    :precondition (and (courier ?r) (not (open-c)) ([?r] (not (open-c))))
  )

  (:event e-tell-c-else
    :parameters (?r - agent)
    :precondition (not (and (courier ?r) (not (open-c)) ([?r] (not (open-c)))))
  )

  (:action tell-c
    :parameters (?r - agent)
    :action-type (public-announcement (e-tell-c ?r) (e-tell-c-else ?r))
    :observability-conditions (default Fully)
  )

  (:event e-tell-d
    :parameters (?r - agent)
    :precondition (and (courier ?r) (not (open-d)) ([?r] (not (open-d))))
  )

  (:event e-tell-d-else
    :parameters (?r - agent)
    :precondition (not (and (courier ?r) (not (open-d)) ([?r] (not (open-d)))))
  )

  (:action tell-d
    :parameters (?r - agent)
    :action-type (public-announcement (e-tell-d ?r) (e-tell-d-else ?r))
    :observability-conditions (default Fully)
  )

  ;;--------------------THE PORTER AT TWO------------------
  ;;
  ;; Every robot knows he walks; none sees whether he opens what he shut at one.

  (:event e-round
    :parameters (?r - agent)
    :precondition (and (porter ?r) (not (round-done)) (forall (?i - agent) (imply (courier ?i) (delivered ?i))))
    :effects (:and (round-done) (when (reopens) (:and (open-a) (open-b) (open-c) (open-d))))
  )

  (:action round
    :parameters (?r - agent)
    :action-type (public-ontic (e-round ?r))
    :observability-conditions (default Fully)
  )

)
