;; BELIEF REVISION IN A CHANGING WARD. Written by tools/model.py in
;; belief_revision_demo; do not edit by hand.
;;
;; A hospital floor at night. Four fire doors, A to D from west to east, close
;; four lobbies through a band of linen rooms between the hall and the corridor;
;; each lobby turns once, so its door is seen only from a bend inside it. At one
;; the night porter walks a loop, north through one door and south through
;; another, shutting both. Nobody sees him. At two he walks it back and opens
;; them again, unless he is held up.
;;
;; The couriers know every loop is possible and how plausible each is: every
;; world carries its Spohn rank as a grade atom (g0..g6), fixed when the
;; problem is written and never changed by an action. Belief is a formula over
;; knowledge and the grades (tools/model.py), and revision is what a look or a
;; report does to knowledge: it removes worlds, and the least grade among the
;; worlds left says what is believed. Every relation stays an equivalence.
;;
;; A courier enters a lobby only if it does not believe its door shut, seeks
;; along the hall or the corridor only if it does not believe every door ahead
;; shut, and crosses only a door it knows to be open.

(define (domain belief-revision)

  (:requirements
    :equality :partial-observability :ontic-actions :negative-preconditions
    :modal-preconditions :conditional-effects :universal-preconditions :disjunctive-preconditions
  )

  (:action-type-libraries intermediate)

  (:predicates
    (open-a)
    (open-b)
    (open-c)
    (open-d)
    (g0)
    (g1)
    (g2)
    (g3)
    (g4)
    (g5)
    (g6)
    (at-va ?r - agent)
    (at-vb ?r - agent)
    (at-st ?r - agent)
    (at-vc ?r - agent)
    (at-vd ?r - agent)
    (at-sp ?r - agent)
    (at-nw ?r - agent)
    (at-na ?r - agent)
    (at-nb ?r - agent)
    (at-nc ?r - agent)
    (at-nd ?r - agent)
    (at-ja ?r - agent)
    (at-jb ?r - agent)
    (at-jc ?r - agent)
    (at-jd ?r - agent)
    (at-ka ?r - agent)
    (at-kb ?r - agent)
    (at-kc ?r - agent)
    (at-kd ?r - agent)
    (at-hc ?r - agent)
    (at-ht ?r - agent)
    (at-rc ?r - agent)
    (at-rd ?r - agent)
    (courier ?r - agent)
    (porter ?r - agent)
    (out ?r - agent)
    (back ?r - agent)
    (delivered ?r - agent)
    (home ?r - agent)
    (lives-hc ?r - agent)
    (lives-ht ?r - agent)
    (bed-rc ?r - agent)
    (bed-rd ?r - agent)
    (round-done)
    (reopens)
  )

  (:event nil)

  ;;--------------------LEAVING THE ROOM------------------

  (:event e-set-out
    :parameters (?r - agent)
    :precondition (and (courier ?r) (out ?r) (or (at-hc ?r) (at-ht ?r)))
    :effects (:and (when (at-hc ?r) (:and (at-sp ?r) (not (at-hc ?r)))) (when (at-ht ?r) (:and (at-st ?r) (not (at-ht ?r)))))
  )

  (:action set-out
    :parameters (?r - agent)
    :action-type (public-ontic (e-set-out ?r))
    :observability-conditions (default Fully)
  )

  ;;--------------------SEEKING------------------
  ;;
  ;; A hop along the hall on the way out, or along the corridor on the way back,
  ;; only towards a door the robot does not believe shut.

  (:event e-seek-va-vb
    :parameters (?r - agent)
    :precondition (and (courier ?r) (out ?r) (at-va ?r) (or (not ([?r] (not (and (g0) (or (open-b) (open-c) (open-d)))))) (and ([?r] (and (not (g0)))) (not ([?r] (not (and (g1) (or (open-b) (open-c) (open-d))))))) (and ([?r] (and (not (g0)) (not (g1)))) (not ([?r] (not (and (g2) (or (open-b) (open-c) (open-d))))))) (and ([?r] (and (not (g0)) (not (g1)) (not (g2)))) (not ([?r] (not (and (g3) (or (open-b) (open-c) (open-d))))))) (and ([?r] (and (not (g0)) (not (g1)) (not (g2)) (not (g3)))) (not ([?r] (not (and (g4) (or (open-b) (open-c) (open-d))))))) (and ([?r] (and (not (g0)) (not (g1)) (not (g2)) (not (g3)) (not (g4)))) (not ([?r] (not (and (g5) (or (open-b) (open-c) (open-d))))))) (and ([?r] (and (not (g0)) (not (g1)) (not (g2)) (not (g3)) (not (g4)) (not (g5)))) (not ([?r] (not (and (g6) (or (open-b) (open-c) (open-d)))))))))
    :effects (:and (at-vb ?r) (not (at-va ?r)))
  )

  (:action seek-va-vb
    :parameters (?r - agent)
    :action-type (public-ontic (e-seek-va-vb ?r))
    :observability-conditions (default Fully)
  )

  (:event e-seek-vb-va
    :parameters (?r - agent)
    :precondition (and (courier ?r) (out ?r) (at-vb ?r) (or (not ([?r] (not (and (g0) (open-a))))) (and ([?r] (and (not (g0)))) (not ([?r] (not (and (g1) (open-a)))))) (and ([?r] (and (not (g0)) (not (g1)))) (not ([?r] (not (and (g2) (open-a)))))) (and ([?r] (and (not (g0)) (not (g1)) (not (g2)))) (not ([?r] (not (and (g3) (open-a)))))) (and ([?r] (and (not (g0)) (not (g1)) (not (g2)) (not (g3)))) (not ([?r] (not (and (g4) (open-a)))))) (and ([?r] (and (not (g0)) (not (g1)) (not (g2)) (not (g3)) (not (g4)))) (not ([?r] (not (and (g5) (open-a)))))) (and ([?r] (and (not (g0)) (not (g1)) (not (g2)) (not (g3)) (not (g4)) (not (g5)))) (not ([?r] (not (and (g6) (open-a))))))))
