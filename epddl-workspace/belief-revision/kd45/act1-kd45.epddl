;; BELIEF REVISION IN A CHANGING WARD, act 1, the KD45 control: the courier believes the
;; rostered night and nothing ranks the others. Written by tools/model.py.
;; Upper case is a door the porter shut at one; + he reopens them at two, - he is held up.
;;   w0: CD   rank 0
;;   w1: AB   rank 1
;;   w2: AC   rank 2
;;   w3: AD   rank 2
;;   w4: BC   rank 2
;;   w5: BD   rank 2

(define (problem act1-kd45)
  (:domain belief-revision-kd45)
  (:requirements :KD45-frames :general-frames :multi-pointed-models :modal-goals :negative-preconditions)
  (:agents c)
  (:init
    :worlds (w0 w1 w2 w3 w4 w5)
    :relations (
      c (:and (w0 w0) (w1 w0) (w2 w0) (w3 w0) (w4 w0) (w5 w0))
    )
    :labels (
      w0 (:and (open-a) (open-b) (courier c) (out c) (at-hc c) (lives-hc c) (bed-rc c))
      w1 (:and (open-c) (open-d) (courier c) (out c) (at-hc c) (lives-hc c) (bed-rc c))
      w2 (:and (open-b) (open-d) (courier c) (out c) (at-hc c) (lives-hc c) (bed-rc c))
      w3 (:and (open-b) (open-c) (courier c) (out c) (at-hc c) (lives-hc c) (bed-rc c))
      w4 (:and (open-a) (open-d) (courier c) (out c) (at-hc c) (lives-hc c) (bed-rc c))
      w5 (:and (open-a) (open-c) (courier c) (out c) (at-hc c) (lives-hc c) (bed-rc c))
    )
    :designated (w0 w1 w2 w3 w4 w5)
  )
  (:goal (and (delivered c)))
)
