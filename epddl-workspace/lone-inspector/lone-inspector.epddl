;; lone-inspector -- one agent, one accessibility relation.
;;
;; The single-agent case of the warehouse: a robot must deliver a crate it may
;; lift only where it knows the crate is. With one agent there is no
;; observability to declare, since every event is observed by the only agent
;; there is, and every action type collapses to its public form. Sensing
;; refines the agent's partition and ontic change moves within a cell of it,
;; so the frame is S5 at every reachable state.

(define (domain lone-inspector)
    (:requirements
        :typing :facts :equality
        :partial-observability :ontic-actions
        :lists :list-comprehensions
        :negative-preconditions :modal-preconditions :knowing-whether
        :group-modalities :multi-pointed-models
    )

    (:action-type-libraries intermediate)

    (:types zone)

    (:predicates
        (at-ag ?i - agent ?z - zone)
        (crate-at ?z - zone)
        (carrying ?i - agent)
        (delivered)
        ;; Rigid: the floor plan does not change while the robot works.
        (:fact adjacent ?z1 ?z2 - zone)
        (:fact bay      ?z      - zone)
        (:fact dock     ?z      - zone)
    )

    (:event nil)

    ;--------------------MOVE------------------

    (:event e-go
        :parameters (?i - agent ?from ?to - zone)
        :precondition
            (and (at-ag ?i ?from) (adjacent ?from ?to) (not (at-ag ?i ?to)))
        :effects
            (:and (not (at-ag ?i ?from)) (at-ag ?i ?to))
    )

    (:action go
        :parameters (?i - agent ?from ?to - zone)
        :action-type (public-ontic (e-go ?i ?from ?to))
        :observability-conditions (default Fully)
    )

    ;--------------------INSPECT------------------
    ;
    ; Two designated events, one per reading, so the plan branches here. The
    ; agent observes the outcome; with no second agent, nothing is withheld
    ; and the relation stays an equivalence.

    (:event e-inspect-found
        :parameters (?i - agent ?z - zone)
        :precondition
            (and (at-ag ?i ?z) (bay ?z) (crate-at ?z) (<Kw. ?i> (crate-at ?z)))
    )

    (:event e-inspect-empty
        :parameters (?i - agent ?z - zone)
        :precondition
            (and (at-ag ?i ?z) (bay ?z) (not (crate-at ?z))
                 (<Kw. ?i> (crate-at ?z)))
    )

    (:action inspect
        :parameters (?i - agent ?z - zone)
        :action-type (public-sensing
            (e-inspect-found ?i ?z)
            (e-inspect-empty ?i ?z))
        :observability-conditions (default Fully)
    )

    ;--------------------HANDLING------------------
    ;
    ; The modal precondition is the point: the robot may lift the crate only
    ; where it knows the crate is. Without that conjunct a plan that never
    ; inspects anything is valid.

    (:event e-pickup
        :parameters (?i - agent ?z - zone)
        :precondition
            (and (at-ag ?i ?z) (bay ?z) (crate-at ?z) ([?i] (crate-at ?z))
                 (not (carrying ?i)))
        :effects
            (:and (carrying ?i) (not (crate-at ?z)))
    )

    (:action pickup
        :parameters (?i - agent ?z - zone)
        :action-type (public-ontic (e-pickup ?i ?z))
        :observability-conditions (default Fully)
    )

    (:event e-unload
        :parameters (?i - agent ?z - zone)
        :precondition (and (at-ag ?i ?z) (dock ?z) (carrying ?i))
        :effects (:and (delivered) (not (carrying ?i)))
    )

    (:action unload
        :parameters (?i - agent ?z - zone)
        :action-type (public-ontic (e-unload ?i ?z))
        :observability-conditions (default Fully)
    )
)
