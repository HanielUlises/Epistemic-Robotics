(define (problem relay-trio)

  ;; Same facility, and now both idle robots stand at home for the whole
  ;; shift -- the courier's own starting zone, which no location-gated event
  ;; in this domain ever touches. Two robots now want the same fact r2 wanted
  ;; alone in relay-pair. Reaching each of them with its own radio call would
  ;; cost two actions; the fleet channel reaches both at once, and that is
  ;; the saving three robots make visible that two could not.

  (:domain robot-relay)

  (:requirements
    :KD45-frames :finitary-S5-theories :common-knowledge
    :typing :facts :equality
    :multi-pointed-models
    :modal-goals :negative-goals :negative-preconditions :knowing-whether
    :list-comprehensions
  )

  (:agents r1 r2 r3)

  (:objects home lane bayA bayB relay1 relay2 depot - zone)

  (:facts-init
    (adjacent home lane) (adjacent lane home)
    (adjacent lane bayA) (adjacent bayA lane)
    (adjacent lane bayB) (adjacent bayB lane)
    (adjacent lane relay1) (adjacent relay1 lane)
    (adjacent relay1 relay2) (adjacent relay2 relay1)
    (adjacent relay2 depot) (adjacent depot relay2)

    (bay bayA) (bay bayB)
    (depot depot)

    (courier r1)
  )

  (:init
    (:and
      (at-ag r1 home)
      (not (at-ag r1 lane)) (not (at-ag r1 bayA)) (not (at-ag r1 bayB))
      (not (at-ag r1 relay1)) (not (at-ag r1 relay2)) (not (at-ag r1 depot))
      (at-ag r2 home)
      (not (at-ag r2 lane)) (not (at-ag r2 bayA)) (not (at-ag r2 bayB))
      (not (at-ag r2 relay1)) (not (at-ag r2 relay2)) (not (at-ag r2 depot))
      (at-ag r3 home)
      (not (at-ag r3 lane)) (not (at-ag r3 bayA)) (not (at-ag r3 bayB))
      (not (at-ag r3 relay1)) (not (at-ag r3 relay2)) (not (at-ag r3 depot))
      ([C. All]
        (and (at-ag r1 home)
             (not (at-ag r1 lane)) (not (at-ag r1 bayA)) (not (at-ag r1 bayB))
             (not (at-ag r1 relay1)) (not (at-ag r1 relay2)) (not (at-ag r1 depot))
             (at-ag r2 home)
             (not (at-ag r2 lane)) (not (at-ag r2 bayA)) (not (at-ag r2 bayB))
             (not (at-ag r2 relay1)) (not (at-ag r2 relay2)) (not (at-ag r2 depot))
             (at-ag r3 home)
             (not (at-ag r3 lane)) (not (at-ag r3 bayA)) (not (at-ag r3 bayB))
             (not (at-ag r3 relay1)) (not (at-ag r3 relay2)) (not (at-ag r3 depot))))

      (:forall (?i - agent) (not (carrying ?i))) (not (delivered))
      ([C. All] (and (forall (?i - agent) (not (carrying ?i))) (not (delivered))))

      ([C. All] (and (or (package-at bayA) (package-at bayB))
                     (not (and (package-at bayA) (package-at bayB)))
                     (not (package-at home)) (not (package-at lane))
                     (not (package-at relay1)) (not (package-at relay2))
                     (not (package-at depot))))
      (:forall (?i - agent) ([C. All] (<Kw. ?i> (package-at bayA))))
      (:forall (?i - agent) ([C. All] (<Kw. ?i> (package-at bayB))))
    )
  )

  (:goal
    (and
      (delivered)
      ([Kw. r2] (package-at bayA))
      ([Kw. r3] (package-at bayA))
    )
  )
)
