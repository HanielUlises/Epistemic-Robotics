;; BELIEF AND EMPATHY PARTICLES. A heterogeneous team out of radio contact,
;; after Bramblett and Bezzo, "Epistemic Planning for Heterogeneous Robotic
;; Systems" (arXiv:2308.00579).
;;
;; An aerial vehicle ?u and two ground vehicles split an area at the start,
;; while in contact, and each covers its own part along a route every robot
;; knows. Out of contact, each robot keeps for every other three belief
;; particles: where that robot is if it has had no fault (particle 1), one
;; fault (particle 2, slower) or two (particle 3, slower still). A robot that
;; has a fault does what the others expect of it: it tracks its next particle.
;; That convention, the paper's empathy, is what makes "?g stands at particle b"
;; and "?g has had b-1 faults" the same fact, (p1 ?g), (p2 ?g) or (p3 ?g), and
;; what keeps the robot inside the set of places the others look for it. Each
;; ground vehicle knows its own particle; nobody knows another's. At most two
;; faults happen in the team.
;;
;; The aerial vehicle has found a task, (task), that needs an aerial and a
;; capable ground vehicle at its site together. A ground vehicle with two
;; faults is no longer capable. A ground vehicle drives to the site only when
;; it knows there is a task there, ([?g] (task)), which only a hail can give
;; it: the aerial vehicle flies to one of the ground vehicle's particles and
;; calls. If the vehicle is there, it hears the call and the two exchange what
;; they know (the paper's gossip); the other ground vehicle hears nothing. If
;; it is not, the aerial vehicle learns that, and the vehicle hails nobody.
;;
;; The aerial vehicle is in the west or the east half of the area, where it
;; found the task. The west ground vehicle's particles are in the west half and
;; the east one's in the east; flying to the other half is an action of its
;; own, so that a policy of least depth seeks the nearer vehicle first.

(define (domain belief-empathy)

  (:requirements
    :equality :partial-observability :list-comprehensions :lists
    :ontic-actions :negative-preconditions :modal-preconditions :knowing-whether
    :negative-obs-conditions
  )

  (:action-type-libraries intermediate hailing)

  (:predicates
    (uav ?i - agent)
    (ugv ?i - agent)
    (west ?i - agent)        ; a ground vehicle: it covers the west half; the aerial one: it is there now
    (task)                   ; a task has been found that needs an aerial and a capable ground vehicle
    (p1 ?g - agent)          ; ?g has had no fault and tracks its first particle
    (p2 ?g - agent)          ; one fault: it tracks its second, slower particle
    (p3 ?g - agent)          ; two faults: its third; it can no longer do the task
    (free ?u - agent)        ; the aerial vehicle is not holding at a particle
    (by1 ?g - agent)         ; the aerial vehicle holds at ?g's first particle
    (by2 ?g - agent)
    (by3 ?g - agent)
    (passed1 ?g - agent)     ; the aerial vehicle has hailed at ?g's first particle and found nobody
    (passed2 ?g - agent)
    (at-site ?i - agent)     ; ?i is at the task's site
    (done)                   ; the task has been done
  )

  (:event nil)

  ;;--------------------THE AERIAL VEHICLE CROSSES------------------
  ;; Nobody out of contact sees it.

  (:event e-cross-west
    :parameters (?u - agent)
    :precondition (and (uav ?u) (free ?u) (not (west ?u)))
    :effects (:and (west ?u) (not (at-site ?u)))
  )

  (:action cross-west
    :parameters (?u - agent)
    :action-type (unseen-ontic (e-cross-west ?u) (nil))
    :observability-conditions (:and (?u Fully) (default Unsure))
  )

  (:event e-cross-east
    :parameters (?u - agent)
    :precondition (and (uav ?u) (free ?u) (west ?u))
    :effects (:and (not (west ?u)) (not (at-site ?u)))
  )

  (:action cross-east
    :parameters (?u - agent)
    :action-type (unseen-ontic (e-cross-east ?u) (nil))
    :observability-conditions (:and (?u Fully) (default Unsure))
  )

  ;;--------------------TO A PARTICLE------------------
  ;; The particles lie in order along the ground vehicle's route, the first
  ;; furthest along it, and the aerial vehicle comes from ahead of them: it
  ;; reaches the first directly, in the half the vehicle covers, and the second
  ;; and third only by following the route back from the one before, where it
  ;; has hailed and found nobody. Nobody out of contact sees it.

  (:event e-fly-p1
    :parameters (?u ?g - agent)
    :precondition (and (uav ?u) (ugv ?g) (free ?u)
                       (or (and (west ?u) (west ?g)) (and (not (west ?u)) (not (west ?g)))))
    :effects (:and (by1 ?g) (not (free ?u)) (not (at-site ?u)))
  )

  (:action fly-p1
    :parameters (?u ?g - agent | (/= ?u ?g))
    :action-type (unseen-ontic (e-fly-p1 ?u ?g) (nil))
    :observability-conditions (:and (?u Fully) (default Unsure))
  )

  (:event e-back-p2
    :parameters (?u ?g - agent)
    :precondition (and (uav ?u) (ugv ?g) (free ?u) (passed1 ?g) (not (at-site ?u))
                       (or (and (west ?u) (west ?g)) (and (not (west ?u)) (not (west ?g)))))
    :effects (:and (by2 ?g) (not (passed1 ?g)) (not (free ?u)))
  )

  (:action back-p2
    :parameters (?u ?g - agent | (/= ?u ?g))
    :action-type (unseen-ontic (e-back-p2 ?u ?g) (nil))
    :observability-conditions (:and (?u Fully) (default Unsure))
  )

  (:event e-back-p3
    :parameters (?u ?g - agent)
    :precondition (and (uav ?u) (ugv ?g) (free ?u) (passed2 ?g) (not (at-site ?u))
                       (or (and (west ?u) (west ?g)) (and (not (west ?u)) (not (west ?g)))))
    :effects (:and (by3 ?g) (not (passed2 ?g)) (not (free ?u)))
  )

  (:action back-p3
    :parameters (?u ?g - agent | (/= ?u ?g))
    :action-type (unseen-ontic (e-back-p3 ?u ?g) (nil))
    :observability-conditions (:and (?u Fully) (default Unsure))
  )

  ;;--------------------THE HAIL------------------
  ;; The ground vehicle is there and answers, or it is not. The answer carries
  ;; the task: the met event requires (task), and a vehicle that observes the
  ;; event learns it. It is heard by the vehicle hailed only where the vehicle
  ;; stands at that particle; the other vehicle cannot tell whether anything
  ;; was said. Found absent, the aerial vehicle may follow the route back to
  ;; the next particle.

  (:event e-met-1
    :parameters (?u ?g - agent)
    :precondition (and (uav ?u) (by1 ?g) (p1 ?g) (task))
    :effects (:and (free ?u) (not (by1 ?g)))
  )

  (:event e-absent-1
    :parameters (?u ?g - agent)
    :precondition (and (uav ?u) (by1 ?g) (not (p1 ?g)))
    :effects (:and (free ?u) (not (by1 ?g)) (passed1 ?g))
  )

  (:action hail-p1
    :parameters (?u ?g - agent | (/= ?u ?g))
    :action-type (hail (e-met-1 ?u ?g) (e-absent-1 ?u ?g) (nil))
    :observability-conditions
      (:and (?u Fully)
            (?g (if (p1 ?g) Fully else Unsure))
            (default Unsure))
  )

  (:event e-met-2
    :parameters (?u ?g - agent)
    :precondition (and (uav ?u) (by2 ?g) (p2 ?g) (task))
    :effects (:and (free ?u) (not (by2 ?g)))
  )

  (:event e-absent-2
    :parameters (?u ?g - agent)
    :precondition (and (uav ?u) (by2 ?g) (not (p2 ?g)))
    :effects (:and (free ?u) (not (by2 ?g)) (passed2 ?g))
  )

  (:action hail-p2
    :parameters (?u ?g - agent | (/= ?u ?g))
    :action-type (hail (e-met-2 ?u ?g) (e-absent-2 ?u ?g) (nil))
    :observability-conditions
      (:and (?u Fully)
            (?g (if (p2 ?g) Fully else Unsure))
            (default Unsure))
  )

  (:event e-met-3
    :parameters (?u ?g - agent)
    :precondition (and (uav ?u) (by3 ?g) (p3 ?g) (task))
    :effects (:and (free ?u) (not (by3 ?g)))
  )

  (:event e-absent-3
    :parameters (?u ?g - agent)
    :precondition (and (uav ?u) (by3 ?g) (not (p3 ?g)))
    :effects (:and (free ?u) (not (by3 ?g)))
  )

  (:action hail-p3
    :parameters (?u ?g - agent | (/= ?u ?g))
    :action-type (hail (e-met-3 ?u ?g) (e-absent-3 ?u ?g) (nil))
    :observability-conditions
      (:and (?u Fully)
            (?g (if (p3 ?g) Fully else Unsure))
            (default Unsure))
  )

  ;;--------------------TO THE SITE------------------
  ;; The ground vehicle goes only when it knows there is a task, and only if
  ;; it is still capable, which it knows of itself. Nobody else sees it go.
  ;; The action names the vehicle alone: ePlanSys's executor dispatches
  ;; together consecutive actions whose agents are disjoint, so that the
  ;; aerial vehicle's flight to the site and this drive run at once.

  (:event e-go-site
    :parameters (?g - agent)
    :precondition (and (ugv ?g) (not (at-site ?g)) (or (p1 ?g) (p2 ?g)) ([?g] (task)))
    :effects (at-site ?g)
  )

  (:action go-site
    :parameters (?g - agent)
    :action-type (unseen-ontic (e-go-site ?g) (nil))
    :observability-conditions (:and (?g Fully) (default Unsure))
  )

  (:event e-fly-site
    :parameters (?u - agent)
    :precondition (and (uav ?u) (free ?u) (not (at-site ?u)))
    :effects (at-site ?u)
  )

  (:action fly-site
    :parameters (?u - agent)
    :action-type (unseen-ontic (e-fly-site ?u) (nil))
    :observability-conditions (:and (?u Fully) (default Unsure))
  )

  ;;--------------------THE TASK------------------
  ;; Both at the site, the ground vehicle capable.

  (:event e-perform
    :parameters (?u ?g - agent)
    :precondition (and (uav ?u) (ugv ?g) (at-site ?u) (at-site ?g) (task) (or (p1 ?g) (p2 ?g)) (not (done)))
    :effects (done)
  )

  (:action perform
    :parameters (?u ?g - agent | (/= ?u ?g))
    :action-type (unseen-ontic (e-perform ?u ?g) (nil))
    :observability-conditions (:and (?u Fully) (?g Fully) (default Unsure))
  )
)
