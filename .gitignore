# REVTeX puts footnotes in the bibliography by default, unless the nofootinbib
# option is specified. Footnotes are the stored in a file with suffix Notes.bib.
# Uncomment the next line to have this generated file ignored.
#*Notes.bib

# Sources brought in by `vcs import src < eplansys.repos`: eplansys itself and
# the AWS warehouse world the scenario is built on. They are other people's
# repositories and carry their own history; the repos file is what pins them.
ros2_ws/src/eplansys/
ros2_ws/src/ThirdParty/

# What the recorders produce: raw grabs, composed films, run logs and the
# analysis read back off them. All of it is regenerated by re-running the
# scenario, and the published films live on gh-pages.
scenarios/*/out/

# Recorded runs: the raw grab and the log are large and reproducible
scenarios/*/out/*.mp4
scenarios/*/out/*.log

# Dropped by rmf_traffic_schedule into whatever directory it is run from
.rmf_schedule_node.yaml

# Cloned third-party simulation assets. dynamic_logistics_warehouse is GPL-2.0
# and this repository is Apache-2.0, so its world is fetched rather than
# vendored. tools/fetch_third_party.sh puts it here.
ros2_ws/third_party/

