<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>muddy_robots_demo</name>
  <version>0.1.0</version>
  <description>
    The muddy children, as robots at a muster point in the AWS RoboMaker small
    warehouse: each robot sees every other robot's fault lamp and not its own,
    the supervisor's public announcement of what every robot may already know
    is what lets the bells inform, and k faulty robots know at the k-th bell.
  </description>
  <maintainer email="hanielulises2003@gmail.com">Haniel Vásquez Morales</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>lifecycle_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>pass_through_demo</depend>
  <depend>plansys2_msgs</depend>
  <depend>plansys2_executor</depend>
  <depend>plansys2_planner</depend>
  <depend>plansys2_problem_expert</depend>
  <depend>plansys2_domain_expert</depend>
  <depend>plansys2_epistemic_msgs</depend>

  <exec_depend>plansys2_bringup</exec_depend>
  <exec_depend>plansys2_epistemic_executor</exec_depend>
  <exec_depend>plansys2_epistemic_bt_builder</exec_depend>
  <exec_depend>plansys2_epistemic_planner</exec_depend>
  <exec_depend>plansys2_epddl_grounder</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>aws_robomaker_small_warehouse_world</exec_depend>
  <exec_depend>warehouse_scenario</exec_depend>
  <exec_depend>warehouse_xl_rmf_demo</exec_depend>
  <exec_depend>coordinated_attack_demo</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
