<?xml version="1.0" ?>
<!--
  MUNDO 1: Laberinto con Zonas de Señal Limitada
  ================================================
  Propósito: Modelar pérdida de comunicación entre agentes mediante
             zonas separadas por paredes gruesas (blindadas).
  Características:
    - Laberinto 2D con pasillos de 1.5m de ancho
    - 3 zonas diferenciadas: A (entrada), B (central), C (salida)
    - Paredes gruesas entre zonas simulan pérdida de señal
    - Obstáculos internos que fuerzan replanificación
    - Escala: 20m x 20m
  Uso en proyecto:
    - Zona A→B: agentes pierden comunicación al cruzar muro grueso
    - Zona B→C: reunificación y actualización epistémica
    - Ideal para validar DEL en escenarios de comunicación restringida
-->
<sdf version="1.6">
  <world name="maze_signal_zones">

    <!-- ============================================================ -->
    <!-- CONFIGURACIÓN GLOBAL                                          -->
    <!-- ============================================================ -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>

    <!-- Luz solar -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Luz ambiental -->
    <light name="ambient_light" type="point">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Plano del suelo -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- MURO PERIMETRAL EXTERIOR (20m x 20m)                         -->
    <!-- ============================================================ -->

    <!-- Muro Norte -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 10 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 0.2 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20 0.2 2</size></box></geometry>
          <material><ambient>0.3 0.3 0.6 1</ambient><diffuse>0.3 0.3 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Muro Sur -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -10 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 0.2 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20 0.2 2</size></box></geometry>
          <material><ambient>0.3 0.3 0.6 1</ambient><diffuse>0.3 0.3 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Muro Este -->
    <model name="wall_east">
      <static>true</static>
      <pose>10 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 20 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 20 2</size></box></geometry>
          <material><ambient>0.3 0.3 0.6 1</ambient><diffuse>0.3 0.3 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Muro Oeste -->
    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 20 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 20 2</size></box></geometry>
          <material><ambient>0.3 0.3 0.6 1</ambient><diffuse>0.3 0.3 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- MURO DIVISORIO ZONA A | ZONA B (grosor 1.0m = señal bloqueada)-->
    <!-- Apertura en y=3 para cruce (pasillo angosto de 1.5m)         -->
    <!-- ============================================================ -->

    <!-- Segmento norte del divisor A|B -->
    <model name="divider_ab_north">
      <static>true</static>
      <pose>-1.75 3.25 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 13.5 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 13.5 2</size></box></geometry>
          <material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.7 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segmento sur del divisor A|B -->
    <model name="divider_ab_south">
      <static>true</static>
      <pose>-1.75 -6.25 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 7.5 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 7.5 2</size></box></geometry>
          <material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.7 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- MURO DIVISORIO ZONA B | ZONA C (grosor 1.0m)                 -->
    <!-- Apertura en y=-2 para cruce                                   -->
    <!-- ============================================================ -->

    <!-- Segmento norte del divisor B|C -->
    <model name="divider_bc_north">
      <static>true</static>
      <pose>3.25 1.5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 17 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 17 2</size></box></geometry>
          <material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.7 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segmento sur del divisor B|C -->
    <model name="divider_bc_south">
      <static>true</static>
      <pose>3.25 -7.25 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 5.5 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 5.5 2</size></box></geometry>
          <material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.7 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- OBSTÁCULOS INTERNOS ZONA A (oeste, color verde oscuro)        -->
    <!-- ============================================================ -->
    <model name="obs_a1">
      <static>true</static>
      <pose>-7 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 1.5 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.5 1</size></box></geometry>
          <material><ambient>0.1 0.5 0.1 1</ambient><diffuse>0.1 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obs_a2">
      <static>true</static>
      <pose>-6 -1 0.5 0 0 0.785</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2 0.5 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2 0.5 1</size></box></geometry>
          <material><ambient>0.1 0.5 0.1 1</ambient><diffuse>0.1 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obs_a3">
      <static>true</static>
      <pose>-8 -6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 0.5 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3 0.5 1</size></box></geometry>
          <material><ambient>0.1 0.5 0.1 1</ambient><diffuse>0.1 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- OBSTÁCULOS INTERNOS ZONA B (central, color amarillo)          -->
    <!-- ============================================================ -->
    <model name="obs_b1">
      <static>true</static>
      <pose>1 6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 3 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1 3 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.1 1</ambient><diffuse>0.7 0.7 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obs_b2">
      <static>true</static>
      <pose>0.5 -3 0.5 0 0 0.523</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 0.5 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.5 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.1 1</ambient><diffuse>0.7 0.7 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- OBSTÁCULOS INTERNOS ZONA C (este, color naranja)              -->
    <!-- ============================================================ -->
    <model name="obs_c1">
      <static>true</static>
      <pose>7 7 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2 2 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2 2 1</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obs_c2">
      <static>true</static>
      <pose>6 1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 4 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 4 1</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obs_c3">
      <static>true</static>
      <pose>8 -5 0.5 0 0 0.785</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 0.5 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3 0.5 1</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- MARCADORES DE ZONA (cilindros de referencia visual)           -->
    <!-- ============================================================ -->
    <model name="marker_zone_a">
      <static>true</static>
      <pose>-7 8.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.1</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="marker_zone_b">
      <static>true</static>
      <pose>0.5 8.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.1</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="marker_zone_c">
      <static>true</static>
      <pose>7 8.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.1</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Posiciones de spawn sugeridas para agentes:            -->
    <!-- Agente 1: pose="-8 -8 0.1 0 0 0"  (Zona A)           -->
    <!-- Agente 2: pose="-8 8 0.1 0 0 0"   (Zona A)           -->
    <!-- Objetivo: pose="8 -8 0.1 0 0 0"   (Zona C)           -->

  </world>
</sdf>
