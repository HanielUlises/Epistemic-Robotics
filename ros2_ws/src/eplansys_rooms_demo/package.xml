<?xml version="1.0"?>
<package format="3">
  <name>eplansys_rooms_demo</name>
  <version>0.1.0</version>
  <description>
    The six-room building, executed by ePlanSys. Supplies the one thing the
    planning stack cannot: an action that moves the robot. Everything else in
    the demo is ePlanSys configuration.
  </description>
  <maintainer email="hanielulises2003@gmail.com">Haniel Ulises</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>plansys2_executor</depend>
  <depend>plansys2_epistemic_executor</depend>
  <depend>plansys2_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
