<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>hotel_rmf_demo</name>
  <version>0.1.0</version>
  <description>
    The hotel incident: an epistemic mission whose world changes under it,
    executed over an Open-RMF fleet across three floors and two lifts.
  </description>
  <maintainer email="hanielulises@gmail.com">Haniel Ulises</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>plansys2_executor</depend>
  <depend>plansys2_planner</depend>
  <depend>plansys2_problem_expert</depend>
  <depend>plansys2_domain_expert</depend>
  <depend>plansys2_msgs</depend>

  <exec_depend>eplansys_rmf_bridge</exec_depend>
  <exec_depend>plansys2_bringup</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
