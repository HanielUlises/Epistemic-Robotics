{
  "zones": {
    "lobby":    "lobby",
    "l2_suite": "L2_master_suite",
    "l3_suite": "L3_master_suite"
  },

  "agents": {
    "inspector": {"fleet": "tinyRobot",      "robot": "tinyBot_1"},
    "porter":    {"fleet": "deliveryRobot",  "robot": "deliveryBot_1"}
  },

  "actions": {
    "goto_zone":  {"waypoint_arg": 2},

    "deploy": {
      "movements": [
        {"agent_arg": 0, "waypoint_arg": 3},
        {"agent_arg": 1, "waypoint_arg": 5}
      ]
    },

    "look_into": {
      "waypoint_arg": 1,
      "sensing": true,
      "outcome_arg": 1,
      "outcomes": {
        "l2_suite": "e-inspect-wet",
        "l3_suite": "e-inspect-dry"
      },
      "default_outcome": "e-inspect-dry"
    },

    "shut_valve": {"waypoint_arg": 1},

    "radio": {"local": true, "duration": 4.0},
    "page":  {"local": true, "duration": 4.0}
  }
}
