<?xml version='1.0' ?>
<!--
  The rmf_demos hotel fleets, with the two arguments the bridge needs.

  rmf_demos_gz_classic/hotel.launch.xml forwards only gazebo_version,
  use_sim_time and the lift watchdog flag, and rmf_demos/hotel.launch.xml
  forwards only use_sim_time. Neither passes server_uri or use_rmf_panel down
  to common.launch.xml, so setting them on the command line of either has no
  effect and says nothing about it. This assembles the same demo from the same
  pieces and passes both.

  server_uri is how a fleet adapter is told where to publish its task states
  and logs, and on Humble that websocket is the only place they go. The panel
  is off because it owns port 7878 and an adapter has one server_uri.

  All three fleets are launched, not only the two the mission drives. The
  cleaner fleet shares the lifts and the corridor, which is the traffic the
  planner never sees and RMF has to resolve.
-->
<launch>
  <arg name="gazebo_version" default="11"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="server_uri" default=""/>
  <arg name="use_rmf_panel" default="false"/>
  <arg name="headless" default="false"/>

  <include file="$(find-pkg-share rmf_demos)/common.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="viz_config_file" value="$(find-pkg-share rmf_demos)/include/hotel/hotel.rviz"/>
    <arg name="config_file" value="$(find-pkg-share rmf_demos_maps)/hotel/hotel.building.yaml"/>
    <arg name="dashboard_config_file" value="$(find-pkg-share rmf_demos_dashboard_resources)/hotel/dashboard_config.json"/>
    <arg name="server_uri" value="$(var server_uri)"/>
    <arg name="use_rmf_panel" value="$(var use_rmf_panel)"/>
    <arg name="headless" value="$(var headless)"/>
  </include>

  <set_env name="EXPT_LIFT_WATCHDOG_SRV" value=""/>

  <group>
    <include file="$(find-pkg-share rmf_demos_fleet_adapter)/launch/fleet_adapter.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="nav_graph_file" value="$(find-pkg-share rmf_demos_maps)/maps/hotel/nav_graphs/1.yaml"/>
      <arg name="config_file" value="$(find-pkg-share rmf_demos)/config/hotel/cleanerBotA_config.yaml"/>
      <arg name="server_uri" value="$(var server_uri)"/>
    </include>
  </group>

  <group>
    <include file="$(find-pkg-share rmf_demos_fleet_adapter)/launch/fleet_adapter.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="nav_graph_file" value="$(find-pkg-share rmf_demos_maps)/maps/hotel/nav_graphs/0.yaml"/>
      <arg name="config_file" value="$(find-pkg-share rmf_demos)/config/hotel/tinyRobot_config.yaml"/>
      <arg name="server_uri" value="$(var server_uri)"/>
    </include>
  </group>

  <group>
    <include file="$(find-pkg-share rmf_demos_fleet_adapter)/launch/fleet_adapter.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="nav_graph_file" value="$(find-pkg-share rmf_demos_maps)/maps/hotel/nav_graphs/2.yaml"/>
      <arg name="config_file" value="$(find-pkg-share rmf_demos)/config/hotel/deliveryRobot_config.yaml"/>
      <arg name="server_uri" value="$(var server_uri)"/>
      <arg name="experimental_lift_watchdog_service" value=""/>
    </include>
  </group>

  <group>
    <let name="docking_config_file" value="$(find-pkg-share rmf_demos_tasks)/hotel_cleaner_config.yaml"/>
    <node pkg="rmf_demos_tasks" exec="mock_docker" args="-c $(var docking_config_file)">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
  </group>

  <!--
    rmf_demos_gz_classic/simulation.launch.xml would do this, and it takes the
    world from rmf_demos_maps. The world is copied into this package for one
    change: its GUI camera is pointed straight down at the middle of the
    building instead of at the south face. Nothing in this map models a
    ceiling, so a camera above it sees into whichever floor the toggle_floors
    plugin is showing, and the recorder drives those buttons to follow the
    agent that is acting. Models, assets and plugins all still come from
    rmf_demos.
  -->
  <let name="world_path" value="$(find-pkg-share hotel_rmf_demo)/worlds/hotel.world"/>
  <let name="model_path" value="$(find-pkg-share rmf_demos_maps)/maps/hotel/models:$(find-pkg-share rmf_demos_assets)/models:/usr/share/gazebo-$(var gazebo_version)/models"/>
  <let name="resource_path" value="$(find-pkg-share rmf_demos_assets):/usr/share/gazebo-$(var gazebo_version)"/>
  <let name="plugin_path" value="$(find-pkg-prefix rmf_robot_sim_gz_classic_plugins)/lib/rmf_robot_sim_gz_classic_plugins:$(find-pkg-prefix rmf_building_sim_gz_classic_plugins)/lib/rmf_building_sim_gz_classic_plugins:/usr/share/gazebo-$(var gazebo_version)"/>

  <executable cmd="gzserver --verbose -s libgazebo_ros_factory.so -s libgazebo_ros_init.so $(var world_path)" output="both">
    <env name="GAZEBO_MODEL_PATH" value="$(var model_path)"/>
    <env name="GAZEBO_RESOURCE_PATH" value="$(var resource_path)"/>
    <env name="GAZEBO_PLUGIN_PATH" value="$(var plugin_path)"/>
    <env name="GAZEBO_MODEL_DATABASE_URI" value=""/>
  </executable>
  <group unless="$(var headless)">
    <executable cmd="gzclient --verbose $(var world_path)" output="both">
      <env name="GAZEBO_MODEL_PATH" value="$(var model_path)"/>
      <env name="GAZEBO_RESOURCE_PATH" value="$(var resource_path)"/>
      <env name="GAZEBO_PLUGIN_PATH" value="$(var plugin_path)"/>
    </executable>
  </group>
</launch>
