(define (domain coordinated-attack)

  ;; Two robots have to lift one load together, and which of two stands it is
  ;; on is written in a work order only one of them can read.
  ;;
  ;; The lift is joint. Each robot drives under its own end of the load and
  ;; raises it; an end raised alone tips the load off the stand, and a robot
  ;; that waits does no harm. So a robot raises only if it knows the other
  ;; raises with it, and the other raises only under the same condition. The
  ;; weakest condition that satisfies both is common knowledge of where the
  ;; lift is (Halpern and Moses, 1990), and that is the precondition of lift.
  ;;
  ;; Two ways to say where it is. The radio reaches either robot from anywhere
  ;; and can lose a message without anyone knowing it did. The beacon is a
  ;; stack light that only a robot standing at a viewpoint can see, and the
  ;; viewpoints are on the floor plan, so that a robot sees it is common
  ;; knowledge. The domain asks which of the two can produce the precondition.

  (:requirements
    :typing :equality :partial-observability :list-comprehensions :lists
    :ontic-actions :group-modalities :static-common-knowledge
    :negative-preconditions :modal-preconditions :knowing-whether
  )

  (:action-type-libraries intermediate lossy)

  (:types stand)

  (:predicates
    ;; The work order names this stand: its load is the one to lift.
    (job ?s - stand)
    ;; Who can read the work order. Static, and common knowledge.
    (reads-order ?i - agent)
    ;; Whether this floor has a beacon at all. Static, and common knowledge.
    (beacon)
    ;; The robot stands at a viewpoint of the beacon.
    (at-view ?i - agent)
    (lifted)
    ;; The sender's log: this message has gone out, arrived or not.
    (sent-tell) (sent-ack) (sent-ack2) (sent-ack3)
  )

  (:event nil)

  ;--------------------READ THE WORK ORDER------------------
  ;
  ; Semi-private sensing. The reader learns which stand; the other robot
  ; learns that the order was read and not what it said.
  ;
  ; The order is read at a terminal, which is not a viewpoint of the beacon,
  ; so a robot standing at its viewpoint would have to leave it to read. A
  ; sensing event carries no effects in this library, so the domain cannot
  ; say that reading takes the robot away from the viewpoint; it says instead
  ; that the order is read before the reader goes there. Without this the
  ; planner sent south to its viewpoint first, and the run then drove it back
  ; to the terminal and had it signal from there, out of sight of the beacon.

  (:event e-here
    :parameters (?i - agent ?s - stand)
    :precondition (and (reads-order ?i) (not (at-view ?i)) (job ?s) (<Kw. ?i> (job ?s)))
  )

  (:event e-elsewhere
    :parameters (?i - agent ?s - stand)
    :precondition (and (reads-order ?i) (not (at-view ?i)) (not (job ?s)) (<Kw. ?i> (job ?s)))
  )

  (:action read-order
    :parameters (?i - agent ?s - stand)
    :action-type (semi-private-sensing (e-here ?i ?s) (e-elsewhere ?i ?s))
    :observability-conditions (:and (?i Fully) (default Partially))
  )

  ;--------------------RADIO------------------
  ;
  ; Four messages, each one level deeper than the last: the order, its
  ; acknowledgement, the acknowledgement of that, and so on. A robot sends
  ; what it knows, so each message's precondition is the sender knowing the
  ; content of the one before.
  ;
  ; Each goes out at most once, which the sender's log enforces. Without that
  ; bound a message can be repeated, every repetition leaves a model no
  ; earlier one is bisimilar to, and the space is infinite: the planner can
  ; search it and cannot exhaust it. With the bound it can, and an exhausted
  ; space is a proof that no policy exists, for this protocol of four
  ; messages. That no longer protocol does better is the theorem, not the
  ; search.

  ; Each message has two events with one precondition, the message arriving
  ; and the message lost, and they have to be two events and not one passed
  ; twice: plank keys an event model by event name, so a single event named
  ; in both places becomes one event and the loss disappears from the model.

  (:event e-tell
    :parameters (?i ?j - agent ?s - stand)
    :precondition (and (not (sent-tell)) ([?i] (job ?s)))
    :effects (sent-tell)
  )

  (:event e-tell-lost
    :parameters (?i ?j - agent ?s - stand)
    :precondition (and (not (sent-tell)) ([?i] (job ?s)))
    :effects (sent-tell)
  )

  (:event e-ack
    :parameters (?i ?j - agent ?s - stand)
    :precondition (and (not (sent-ack)) ([?i] ([?j] (job ?s))))
    :effects (sent-ack)
  )

  (:event e-ack-lost
    :parameters (?i ?j - agent ?s - stand)
    :precondition (and (not (sent-ack)) ([?i] ([?j] (job ?s))))
    :effects (sent-ack)
  )

  (:event e-ack2
    :parameters (?i ?j - agent ?s - stand)
    :precondition (and (not (sent-ack2)) ([?i] ([?j] ([?i] (job ?s)))))
    :effects (sent-ack2)
  )

  (:event e-ack2-lost
    :parameters (?i ?j - agent ?s - stand)
    :precondition (and (not (sent-ack2)) ([?i] ([?j] ([?i] (job ?s)))))
    :effects (sent-ack2)
  )

  (:event e-ack3
    :parameters (?i ?j - agent ?s - stand)
    :precondition (and (not (sent-ack3)) ([?i] ([?j] ([?i] ([?j] (job ?s))))))
    :effects (sent-ack3)
  )

  (:event e-ack3-lost
    :parameters (?i ?j - agent ?s - stand)
    :precondition (and (not (sent-ack3)) ([?i] ([?j] ([?i] ([?j] (job ?s))))))
    :effects (sent-ack3)
  )

  (:action tell
    :parameters (?i ?j - agent ?s - stand | (/= ?i ?j))
    :action-type (lossy-message (e-tell ?i ?j ?s) (e-tell-lost ?i ?j ?s) (nil))
    :observability-conditions (:and (?i Sender) (?j Receiver))
  )

  (:action ack
    :parameters (?i ?j - agent ?s - stand | (/= ?i ?j))
    :action-type (lossy-message (e-ack ?i ?j ?s) (e-ack-lost ?i ?j ?s) (nil))
    :observability-conditions (:and (?i Sender) (?j Receiver))
  )

  (:action ack2
    :parameters (?i ?j - agent ?s - stand | (/= ?i ?j))
    :action-type (lossy-message (e-ack2 ?i ?j ?s) (e-ack2-lost ?i ?j ?s) (nil))
    :observability-conditions (:and (?i Sender) (?j Receiver))
  )

  (:action ack3
    :parameters (?i ?j - agent ?s - stand | (/= ?i ?j))
    :action-type (lossy-message (e-ack3 ?i ?j ?s) (e-ack3-lost ?i ?j ?s) (nil))
    :observability-conditions (:and (?i Sender) (?j Receiver))
  )

  ;--------------------GO TO A VIEWPOINT------------------
  ;
  ; Public. Where each robot is follows from the policy both robots run and
  ; from the public history, so it is common knowledge; what is private is
  ; what the order said and whether a message arrived.

  (:event e-go-view
    :parameters (?i - agent)
    :precondition (and (beacon) (not (at-view ?i)))
    :effects (at-view ?i)
  )

  (:action go-view
    :parameters (?i - agent)
    :action-type (public-ontic (e-go-view ?i))
    :observability-conditions (default Fully)
  )

  ;--------------------SIGNAL ON THE BEACON------------------
  ;
  ; An announcement made by lighting the beacon. A robot at a viewpoint sees
  ; it, one elsewhere does not, and since both positions are common
  ; knowledge so is who saw it. With both robots at their viewpoints the
  ; announcement is public, and a public announcement of a fact makes it
  ; common knowledge in one update.

  (:event e-signal
    :parameters (?i - agent ?s - stand)
    :precondition (and (at-view ?i) ([?i] (job ?s)))
  )

  (:action signal
    :parameters (?i - agent ?s - stand)
    :action-type (private-announcement (e-signal ?i ?s) (nil))
    :observability-conditions
      (:forall (?j - agent)
        (?j (if (at-view ?j) Fully else Oblivious)))
  )

  ;--------------------LIFT------------------
  ;
  ; Joint, and public: both robots drive under their ends of the load on the
  ; stand and raise it at the moment the commitment fixes. The precondition
  ; is the coordination requirement stated above.

  (:event e-lift
    :parameters (?s - stand)
    :precondition (and (job ?s) ([C. All] (job ?s)))
    :effects (lifted)
  )

  (:action lift
    :parameters (?s - stand)
    :action-type (public-ontic (e-lift ?s))
    :observability-conditions (default Fully)
  )
)
