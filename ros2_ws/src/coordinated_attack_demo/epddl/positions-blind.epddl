(define (problem coordinated-attack-positions-blind)

  (:domain coordinated-attack-positions)

  ;; The beacon floor of coordinated-attack, with moves witnessed only by the
  ;; mover. From their viewpoints in t2 the robots see each other.
  ;;
  ;; This instance and positions-sight.epddl differ in one line: here the
  ;; viewpoints do not see each other, and the robots have the beacon and the
  ;; radio and no way to learn where the other stands.

  (:requirements
    :typing :equality :list-comprehensions
    :finitary-S5-theories :modal-goals :knowing-whether
    :multi-pointed-models :negative-preconditions
  )

  (:agents south north)

  (:objects s1 s2 - stand)

  (:init
    (:and
      ([C. All] (beacon))
      ([C. All] (not (sightline)))
      ([C. All] (not (lifted)))
      (:forall (?s - stand) ([C. All] (not (lit ?s))))
      ([C. All] (not (sent-tell)))
      ([C. All] (not (sent-ack)))
      ([C. All] (not (sent-ack2)))
      ([C. All] (not (sent-ack3)))
      ([C. All] (reads-order south))
      ([C. All] (not (reads-order north)))
      (:forall (?i - agent) ([C. All] (not (at-view ?i))))
      ([C. All]
        (or
          (and (job s1) (not (job s2)))
          (and (not (job s1)) (job s2))))
      (:forall (?i - agent)
        (:forall (?s - stand)
          ([C. All] (<Kw. ?i> (job ?s)))))
    )
  )

  ;; Ontic. The epistemic content is in the precondition of lift.
  (:goal (lifted))
)
