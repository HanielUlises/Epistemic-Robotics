(define (action-type-library moves)

  ;; A move that only the mover witnesses.
  ;;
  ;; Two events. ?do is the move, with the domain's postconditions; ?skip is
  ;; the robot not having moved, and changes nothing. The mover tells them
  ;; apart. The other robot does not: it relates the two, so it considers
  ;; possible that the move did not happen, and it is not misled into
  ;; believing that it did not. Both relations are equivalences, and an S5
  ;; model stays S5 under the update.
  ;;
  ;; This is the difference from a private ontic action, whose observers that
  ;; do not see it map it onto nothing having happened. That leaves them with
  ;; a false belief about where the mover is, the frame becomes KD45, and the
  ;; first announcement that the mover is somewhere else empties their
  ;; relation. Here no robot believes anything false about the other's
  ;; position; it only does not know it.
  ;;
  ;; Only ?do is designated: in the run the robot does move.

  (:requirements
    :lists :list-comprehensions :equality
    :partial-observability :multi-pointed-models :events-conditions
  )

  (:action-type unwitnessed-move
    :events     (?do ?skip)
    :observability-types (Fully Partially)
    :relations  (Fully     (:forall (?e - event) (?e ?e))
                 Partially (:forall (?e ?f - event) (?e ?f)) )
    :designated (?do)
    :conditions (?skip (:trivial-event))
  )

  ;; An announcement the announcer cannot confirm was received.
  ;;
  ;; Three events: ?seen, the announcement made where the listener can see it;
  ;; ?unseen, the same announcement made where it cannot; ?nil, nothing. The
  ;; announcer relates the first two, the listener the last two: the lossy
  ;; message again, with both of the first two designated, since which occurs
  ;; is a matter of where the listener stands and the domain's preconditions
  ;; decide it. When where the listener stands is common knowledge, ?unseen
  ;; has no world to occur in among those the announcer considers, and the
  ;; type is a public announcement.
  ;;
  ;; It is here because plank, and Aletheia after it, fix an agent's
  ;; observability type once per state, by the conditions at the designated
  ;; worlds. Whether a listener saw an announcement is then common knowledge
  ;; by construction, and a domain that wants it unknown has to say so in the
  ;; event model.

  (:action-type unconfirmed-announcement
    :events     (?seen ?unseen ?nil)
    :observability-types (Announcer Listener)
    :relations  (Announcer (:and (?seen ?seen) (?seen ?unseen) (?unseen ?seen) (?unseen ?unseen) (?nil ?nil))
                 Listener  (:and (?seen ?seen) (?unseen ?unseen) (?unseen ?nil) (?nil ?unseen) (?nil ?nil)))
    :designated (?seen ?unseen)
    :conditions (?nil (:trivial-event))
  )
)
