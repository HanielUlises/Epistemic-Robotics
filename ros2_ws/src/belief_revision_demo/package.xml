<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypenamespace="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>belief_revision_demo</name>
  <version>0.1.0</version>
  <description>Belief revision in a changing ward: Spohn-ranked beliefs in ePlanSys's epistemic state, revised by
    conditioning as a night porter shuts and opens the fire doors no robot sees him touch.</description>
  <maintainer email="hanielulises@gmail.com">Haniel Ulises</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>plansys2_executor</depend>
  <depend>plansys2_msgs</depend>
  <depend>gazebo_dev</depend>
  <depend>gazebo_ros</depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>plansys2_epistemic_msgs</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>plansys2_bringup</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
