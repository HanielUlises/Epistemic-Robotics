<?xml version="1.0"?>
<!--
  A TurtleBot3 Waffle with the scanning laser fitted.

  Only the agent that senses carries one. Gazebo Classic names a plugin's node
  after the plugin, so three robots spawned from one model file give three
  nodes called /lds_driver, and the server reports the collision and then
  segfaults. Fitting the laser to the one robot that needs it is both the fix
  and the honest arrangement: in the domain it is the relay that scans.

  ROBOTIS's Waffle geometry, from turtlebot3_gazebo under Apache-2.0, on
  rmf_demos' TinyRobot drive skeleton, unchanged.

  Both halves of that were arrived at the hard way.

  The skeleton is TinyRobot's because RMF drives a simulated robot with the
  `slotcar` plugin, which is a kinematic driver rather than a controller and is
  particular about the model it is handed. A Waffle built from scratch to what
  slotcar documents — a `base_footprint`, `left_wheel` and `right_wheel`, and
  the revolute joints `joint_tire_left` and `joint_tire_right` — loaded
  without complaint, initialised slotcar, published state at 6 Hz, accepted
  paths from the fleet adapter and did not move a centimetre. TinyRobot crossed
  the same floor on the same graph without trouble, which is what isolated the
  model rather than the world or the roadmap.

  The meshes are scaled, and that is not arbitrary either. turtlebot3_gazebo's
  meshes are STL in millimetres, so a Waffle base is 271 mm across and loads at
  scale 1 as a robot 271 metres wide. (The .dae files beside them in
  turtlebot3_common are placeholder cubes two metres on a side, which is its
  own way of producing an enormous robot.) Millimetres to metres is 0.001;
  the 0.0015 and 0.003 used here also fit the geometry to the skeleton's
  0.326 m wheelbase and 0.1 m wheel radius, so the wheels meet the floor and
  the body sits over them instead of floating.
-->
<sdf version='1.6'>
  <model name='TurtleBot3WaffleLidar'>
    <plugin name="slotcar" filename="libslotcar.so">

      <nominal_drive_speed>0.5</nominal_drive_speed>
      <nominal_drive_acceleration>0.25</nominal_drive_acceleration>
      <max_drive_acceleration>0.75</max_drive_acceleration>

      <nominal_turn_speed>0.6</nominal_turn_speed>
      <nominal_turn_acceleration>1.5</nominal_turn_acceleration>
      <max_turn_acceleration>2.0</max_turn_acceleration>

      <tire_radius>0.1</tire_radius>
      <base_width>0.3206</base_width>

      <stop_distance>0.75</stop_distance>
      <stop_radius>0.75</stop_radius>

      <!-- Can the robot drive backwards -->
      <reversible>true</reversible>

      <!-- Battery params -->
      <nominal_voltage>12.0</nominal_voltage>
      <nominal_capacity>24.0</nominal_capacity>
      <charging_current>5.0</charging_current>

      <!-- Physical params -->
      <mass>20.0</mass>
      <inertia>10.0</inertia>
      <friction_coefficient>0.22</friction_coefficient>

      <!-- Power systems -->
      <nominal_power>20.0</nominal_power>

    </plugin>

    <link name='base_footprint'>
      <pose frame=''>0 0 0 0 -0 0</pose>
      <inertial>
        <pose frame=''>-0.15 0 0.13 0 -0 0</pose>
        <mass>7</mass> <!-- A higher mass causes wheels to spin while attempting to turn when using DART -->
        <inertia>
          <ixx>0.0594508</ixx>
          <ixy>0</ixy>
          <ixz>-2.77556e-17</ixz>
          <iyy>0.150753</iyy>
          <iyz>0</iyz>
          <izz>0.172704</izz>
        </inertia>
      </inertial>
      <collision name='base_footprint_fixed_joint_lump__base_link_collision'>
        <pose frame=''>-0.11 0 0.151 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.398 0.268 0.16</size>
          </box>
        </geometry>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__base_link_collision_1'>
        <pose frame=''>-0.136 0 0.248 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.375 0.268 0.034</size>
          </box>
        </geometry>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__base_link_collision_2'>
        <pose frame=''>-0.279 0.169 0.106 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.07 0.07</size>
          </box>
        </geometry>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__base_link_collision_3'>
        <pose frame=''>-0.279 -0.169 0.106 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.07 0.07</size>
          </box>
        </geometry>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__left_caster_wheel_collision_4'>
        <pose frame=''>-0.3 0.169 0.04 0 -0 0</pose>
        <geometry>
          <sphere>
            <radius>0.04</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e+08</kp>
              <min_depth>0.005</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>0</mu>
              <mu2>0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__raspicam_collision_5'>
        <pose frame=''>0.05 0.085 0.245 0 -1.15192 3.1415</pose>
        <geometry>
          <box>
            <size>0.03 0.026 0.016</size>
          </box>
        </geometry>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__right_caster_wheel_collision_6'>
        <pose frame=''>-0.3 -0.169 0.04 0 -0 0</pose>
        <geometry>
          <sphere>
            <radius>0.04</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e+08</kp>
              <min_depth>0.005</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>0</mu>
              <mu2>0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__sonar_0_collision_7'>
        <pose frame=''>0.01 -0.14 0.25 0 0 -1.5708</pose>
        <geometry>
          <box>
            <size>0.02 0.044 0.021</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__sonar_1_collision_8'>
        <pose frame=''>0.08 -0.07 0.25 0 -0 0.785</pose>
        <geometry>
          <box>
            <size>0.02 0.044 0.021</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__sonar_2_collision_9'>
        <pose frame=''>0.08 -0.01 0.25 0 0 -0.785</pose>
        <geometry>
          <box>
            <size>0.02 0.044 0.021</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__sonar_3_collision_10'>
        <pose frame=''>0.08 0.04 0.25 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.044 0.021</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__sonar_4_collision_11'>
        <pose frame=''>0.01 0.14 0.25 0 -0 1.5708</pose>
        <geometry>
          <box>
            <size>0.02 0.044 0.021</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='waffle_base_visual'>
        <pose frame=''>-0.09 0 0.02 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>0.0015 0.0015 0.0015</scale>
            <uri>model://TurtleBot3Waffle/meshes/waffle_base.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.17 1</ambient>
          <diffuse>0.25 0.25 0.28 1</diffuse>
        </material>
      </visual>
      <visual name='waffle_lds_visual'>
        <pose frame=''>-0.09 0 0.205 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>0.0015 0.0015 0.0015</scale>
            <uri>model://TurtleBot3Waffle/meshes/lds.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <velocity_decay/>
      <velocity_decay/>
      <velocity_decay/>
      <velocity_decay/>


      <!-- The scanning laser. Without it the sensing action has nothing to
           sense with, and the outcome can only come from the task map. The
           Waffle's own LDS is a 360-degree planar scanner at 0.12 to 3.5 m;
           these are its published figures, reduced to 180 samples because the
           detector needs a range and not a picture.

           Mounted at 0.33 m, above the chassis. At 0.22 m it sits inside the
           body's own collision box and every beam returns range_min, so the
           detector reports an obstacle at 0.12 m in any world — including the
           empty one. A laser inside the robot is not a laser. -->
      <sensor name="lds" type="ray">
        <pose>-0.09 0 0.33 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <visualize>0</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>3.5</max>
            <resolution>0.015</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="lds_driver" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>lds_link</frame_name>
        </plugin>
      </sensor>
    </link>
    <link name='left_wheel'>
      <pose frame=''>0 0.163 0.1 0 -0 1.5708</pose>
      <inertial>
        <pose frame=''>0 0 0 3.14159 1.57079 3.14159</pose>
        <mass>3.34</mass>
        <inertia>
          <ixx>0.00904583</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00904583</iyy>
          <iyz>0</iyz>
          <izz>0.0167</izz>
        </inertia>
      </inertial>
      <collision name='left_wheel_collision'>
        <pose frame=''>0 0 0 3.14159 1.57079 3.14159</pose>
        <geometry>
          <sphere>
            <radius>0.1</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode>
            <!--
              <kp>1e+08</kp>
              <min_depth>0.005</min_depth>
              -->
              <kp>10000000.0</kp>
              <kd>1.0</kd>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='left_wheel_visual'>
        <pose frame=''>-0.071 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>0.003 0.003 0.003</scale>
            <uri>model://TurtleBot3Waffle/meshes/left_tire.stl</uri>
          </mesh>
        </geometry>
      </visual>
      <gravity>1</gravity>
      <velocity_decay/>
    </link>
    <joint name='joint_tire_left' type='revolute'>
      <child>left_wheel</child>
      <parent>base_footprint</parent>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>
    <link name='right_wheel'>
      <pose frame=''>0 -0.163 0.1 0 -0 1.5708</pose>
      <inertial>
        <pose frame=''>0 0 0 3.14159 1.57079 3.14159</pose>
        <mass>3.34</mass>
        <inertia>
          <ixx>0.00904583</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00904583</iyy>
          <iyz>0</iyz>
          <izz>0.0167</izz>
        </inertia>
      </inertial>
      <collision name='right_wheel_collision'>
        <pose frame=''>0 0 0 3.14159 1.57079 3.14159</pose>
        <geometry>
          <sphere>
            <radius>0.1</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode>
            <!--
              <kp>1e+08</kp>
              <min_depth>0.005</min_depth>
              -->
              <kp>10000000.0</kp>
              <kd>1.0</kd>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='right_wheel_visual'>
        <pose frame=''>0.071 0 0 -3.14159 0 -3.14159</pose>
        <geometry>
          <mesh>
            <scale>0.003 0.003 0.003</scale>
            <uri>model://TurtleBot3Waffle/meshes/left_tire.stl</uri>
          </mesh>
        </geometry>
      </visual>
      <gravity>1</gravity>
      <velocity_decay/>
    </link>
    <joint name='joint_tire_right' type='revolute'>
      <child>right_wheel</child>
      <parent>base_footprint</parent>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>
    <static>0</static>

  </model>
</sdf>
