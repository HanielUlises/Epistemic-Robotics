# The tool this thesis is built on, and what it needs.
#
# This replaces a symlink at src/eplansys that pointed at an absolute path on
# one machine. Import it instead:
#
#   cd ros2_ws && vcs import src < eplansys.repos
#
# eplansys carries its own dependency_repos.repos for plank, popf and
# cascade_lifecycle. Import that one too, from inside src, once eplansys is
# checked out:
#
#   vcs import src < src/eplansys/dependency_repos.repos
repositories:
  eplansys:
    type: git
    url: https://github.com/ePlanSys/eplansys.git
    version: rolling

  # The world the RoboticsAcademy multi-robot Amazon warehouse exercise runs
  # on. warehouse_scenario's floor plan is rasterised from these very collision
  # meshes, and warehouse_demo launches this world unmodified, so the grid the
  # planner reasons over and the building the laser measures cannot drift.
  ThirdParty/aws-robomaker-small-warehouse-world:
    type: git
    url: https://github.com/aws-robotics/aws-robomaker-small-warehouse-world.git
    version: ros2
